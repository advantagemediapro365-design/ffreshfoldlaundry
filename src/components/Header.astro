---
---

<header>
	<div class="brand-bar"><div class="container brand-content">
		<a class="brand" href="/" aria-label="Fresh Fold Altoona home"><img src="/images/freshfold-logo.jpg" alt="Fresh Fold Altoona" /><span><b>Fresh Fold Altoona</b><small>Pick Up &amp; Delivery</small></span></a>
		<div class="brand-promise">Cleaner Clothes<br /><strong>Happier Days</strong></div>
		<div class="brand-contact"><span>Delivered by<br /><strong>TNT Deliveries</strong></span><a href="tel:+15704947523"><b>☎ Call or Text</b><strong>570-494-7523</strong></a><a class="btn btn-primary" href="/book-pickup">Book Your Pickup</a></div>
	</div></div>
	<nav class="navbar" aria-label="Main navigation"><div class="container nav-container">
		<button type="button" class="hamburger" id="menu-toggle" aria-expanded="false" aria-controls="nav-menu" aria-label="Open navigation menu"><span></span><span></span><span></span></button>
		<div class="nav-panel" id="nav-menu"><ul><li><a href="/">Home</a></li><li><a href="/pricing">Pricing</a></li><li><a href="/subscriptions">Subscriptions</a></li><li><a href="/commercial-laundry">Commercial</a></li><li><a href="/service-areas">Service Areas</a></li><li><a href="/blog">Blog</a></li><li><a href="/faq">FAQ</a></li><li><a href="/contact">Contact</a></li></ul><a class="btn zip-link" href="/service-areas#zipcode">⌖ Check My ZIP</a></div>
	</div></nav>
</header>

<style>
	header { position:sticky; top:0; z-index:1000; background:#fff; box-shadow:0 2px 10px rgba(15,39,66,.12); }.brand-bar { background:#fff; }.brand-content { display:flex; min-height:88px; align-items:center; justify-content:space-between; gap:20px; }.brand { display:flex; align-items:center; gap:10px; color:var(--primary); text-decoration:none; white-space:nowrap; }.brand img { width:62px; height:62px; border-radius:50%; object-fit:contain; }.brand b { display:block; font-family:'Outfit',sans-serif; font-size:1.45rem; line-height:1; }.brand small { display:block; margin-top:4px; color:#009dc4; font-size:.56rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }.brand-promise { padding-left:22px; border-left:1px solid var(--border); color:#1688bd; font-family:cursive; font-size:1.12rem; line-height:1.05; }.brand-promise strong { color:var(--primary); }.brand-contact { display:flex; align-items:center; gap:25px; color:var(--primary); font-size:.7rem; text-align:center; }.brand-contact span { padding-left:25px; border-left:1px solid var(--border); }.brand-contact span strong { font-size:.82rem; }.brand-contact a:not(.btn) { display:grid; color:var(--primary); text-decoration:none; }.brand-contact a:not(.btn) strong { font-size:1.08rem; }.brand-contact .btn { padding:11px 17px; border-radius:8px; font-size:.78rem; color:#fff; }.navbar { background:var(--primary); }.nav-container { display:flex; min-height:37px; align-items:center; justify-content:center; }.nav-panel { display:flex; align-items:center; justify-content:center; gap:24px; width:100%; }.nav-panel ul { display:flex; align-items:center; justify-content:center; gap:28px; margin:0; padding:0; list-style:none; }.nav-panel a { color:#fff; text-decoration:none; font-size:.73rem; font-weight:800; }.nav-panel ul a:hover,.nav-panel ul a:focus-visible { color:#7fe1f2; }.zip-link { margin-left:auto; padding:6px 18px; border-radius:999px; background:#fff; color:var(--primary) !important; font-size:.7rem !important; }.hamburger { display:none; padding:7px; background:transparent; }.hamburger span { display:block; width:25px; height:3px; margin:4px; border-radius:2px; background:#fff; transition:.2s; }
	@media(max-width:900px) { .brand-promise,.brand-contact span { display:none; }.brand-content { min-height:72px; }.brand-contact { margin-left:auto; gap:10px; }.brand-contact a:not(.btn) { display:none; }.nav-container { justify-content:flex-start; min-height:45px; }.hamburger { display:block; }.nav-panel { position:absolute; top:100%; left:0; display:block; width:100%; max-height:0; overflow:hidden; padding:0 20px; background:var(--primary); box-shadow:0 10px 18px rgba(15,39,66,.15); transition:max-height .25s ease,padding .25s ease; }.nav-panel.open { max-height:calc(100vh - 85px); overflow:auto; padding:12px 20px 20px; }.nav-panel ul { display:block; }.nav-panel li { border-bottom:1px solid rgba(255,255,255,.18); }.nav-panel ul a { display:block; padding:14px 3px; font-size:.95rem; }.zip-link { display:flex; margin-top:16px; min-height:45px; }.hamburger.active span:nth-child(1) { transform:translateY(7px) rotate(45deg); }.hamburger.active span:nth-child(2) { opacity:0; }.hamburger.active span:nth-child(3) { transform:translateY(-7px) rotate(-45deg); } }
	@media(max-width:520px) { .brand-content { min-height:64px; padding:0 14px; }.brand b { font-size:1.08rem; }.brand img { width:45px; height:45px; }.brand-contact .btn { padding:9px 10px; font-size:.65rem; }.nav-container { padding:0 14px; } }
</style>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const button = document.querySelector<HTMLButtonElement>('#menu-toggle'); const panel = document.querySelector<HTMLElement>('#nav-menu');
		const close = () => { button?.setAttribute('aria-expanded', 'false'); button?.classList.remove('active'); panel?.classList.remove('open'); };
		button?.addEventListener('click', () => { const open = button.getAttribute('aria-expanded') === 'true'; button.setAttribute('aria-expanded', String(!open)); button.classList.toggle('active', !open); panel?.classList.toggle('open', !open); });
		panel?.querySelectorAll('a').forEach(link => link.addEventListener('click', close)); document.addEventListener('keydown', event => { if (event.key === 'Escape') { close(); button?.focus(); } });
	});
</script>
