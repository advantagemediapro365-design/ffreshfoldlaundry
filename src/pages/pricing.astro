---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Laundry Pickup & Delivery Pricing | Fresh Fold Laundry Delivery Altoona"
	description="Fresh Fold Laundry Delivery Altoona publishes transparent wash, dry, fold, priority, specialty, subscription, and delivery pricing for Central PA routes."
	canonicalPath="/pricing"
>
	<!-- Hero Section -->
	<section class="hero">
		<div class="container">
			<h1>Clear Laundry Pricing. Transparent Delivery.</h1>
			<p>We price laundry processing and delivery logistics separately so you always know what you're paying for—no surprises.</p>
		</div>
	</section>

	<!-- Laundry Pricing -->
	<section class="pricing-services">
		<div class="container">
			<h2>Laundry Services Pricing</h2>
			<p class="section-subtitle">Laundry processing is priced by the pound. Delivery, add-ons, specialty items, and tips are separate line items.</p>
			
			<div class="pricing-cards">
				<div class="pricing-card">
					<div class="service-icon" aria-hidden="true">🧺</div>
					<h3>Standard</h3>
					<div class="price">$1.89<span>/lb</span></div>
					<p>Standard one-time laundry<br>Main everyday price.</p>
				</div>
				<div class="pricing-card">
					<div class="service-icon" aria-hidden="true">⏰</div>
					<h3>Next-Day</h3>
					<div class="price">$2.49<span>/lb</span></div>
					<p>Next-day priority where available<br>Laundry processing only.</p>
				</div>
				<div class="pricing-card featured">
					<div class="badge">Most Popular</div>
					<div class="service-icon" aria-hidden="true">⚡</div>
					<h3>Same-Day Express</h3>
					<div class="price">$2.79<span>/lb</span></div>
					<p>Same-day where available<br>Limited availability.</p>
				</div>
				<div class="pricing-card">
					<div class="service-icon" aria-hidden="true">📦</div>
					<h3>Bulk & Specialty</h3>
					<div class="price">Quote<span></span></div>
					<p>Comforters, rugs, and large orders<br>Priced after review.</p>
				</div>
			</div>
			<p class="pricing-note"><strong>8 lb minimum:</strong> orders below 8 lb are billed as 8 lb. First-month 15% discounts apply to laundry processing only.</p>
		</div>
	</section>

	<!-- Delivery Pricing -->
	<section class="delivery-pricing">
		<div class="container">
			<h2>Delivery Pricing</h2>
			<p class="section-subtitle">Fresh Fold Delivery keeps laundry and delivery pricing separate so customers know exactly what they are paying for.</p>
			<div class="delivery-grid">
				<div class="delivery-item">
					<div class="icon" aria-hidden="true">1x</div>
					<h4>One-Time Customer</h4>
					<p class="price">$3.80 base + $1.75/round-trip mile</p>
				</div>
				<div class="delivery-item">
					<div class="icon" aria-hidden="true">RT</div>
					<h4>Weekly Route Customer</h4>
					<p class="price">$2.50 base + $1.70/round-trip mile</p>
				</div>
				<div class="delivery-item">
					<div class="icon" aria-hidden="true">SUB</div>
					<h4>Subscriber Without Delivery Pass</h4>
					<p class="price">$2.50 base + $1.70/round-trip mile</p>
				</div>
				<div class="delivery-item">
					<div class="icon" aria-hidden="true">DP</div>
					<h4>Delivery Pass Member</h4>
					<p class="price">$0 base + $1.50 intro / $1.70 standard</p>
				</div>
				<div class="delivery-item">
					<div class="icon" aria-hidden="true">BUS</div>
					<h4>Commercial Account</h4>
					<p class="price">Custom base + custom mileage</p>
				</div>
			</div>
			<div class="formula-box">
				<h3>How delivery is estimated</h3>
				<p>Round-trip miles = one-way miles x 2. Delivery fee = base dispatch fee + mileage fee + route, weather, or demand adjustments.</p>
				<p>Final estimate = discounted laundry subtotal + delivery fee + add-ons + specialty items + driver tip - approved discounts.</p>
			</div>
			<p class="pricing-note">Delivery should not be treated as automatically free. Exact delivery charge is confirmed based on address, route availability, timing, weather, and pickup requirements.</p>
		</div>
	</section>

	<!-- Add-Ons -->
	<section class="add-ons">
		<div class="container">
			<h2>Laundry Add-Ons</h2>
			<div class="addons-grid">
				<div class="addon-item">
					<div class="addon-icon">🌿</div>
					<h4>Hypoallergenic Detergent</h4>
					<p class="addon-price">$0.25/lb</p>
				</div>
				<div class="addon-item">
					<div class="addon-icon">0%</div>
					<h4>Fragrance-Free Detergent</h4>
					<p class="addon-price">$0.25/lb</p>
				</div>
				<div class="addon-item">
					<div class="addon-icon">PET</div>
					<h4>Heavy Soil / Pet Hair Treatment</h4>
					<p class="addon-price">$0.50/lb</p>
				</div>
				<div class="addon-item">
					<div class="addon-icon">👕</div>
					<h4>Separate Whites / Colors</h4>
					<p class="addon-price">$5/order</p>
				</div>
				<div class="addon-item">
					<div class="addon-icon">🧥</div>
					<h4>Hang Dry</h4>
					<p class="addon-price">$1/item</p>
				</div>
				<div class="addon-item">
					<div class="addon-icon">✨</div>
					<h4>Stain Treatment</h4>
					<p class="addon-price">$3-$10</p>
				</div>
				<div class="addon-item">
					<div class="addon-icon">+</div>
					<h4>Premium Detergent or Scent Booster</h4>
					<p class="addon-price">$3/order</p>
				</div>
				<div class="addon-item">
					<div class="addon-icon">2X</div>
					<h4>Extra Rinse / Second Wash</h4>
					<p class="addon-price">$3-$5/order or per-lb</p>
				</div>
			</div>
			<p class="pricing-note">Add-ons are separate line items and are not discounted by the first-month laundry discount.</p>
		</div>
	</section>

	<!-- Specialty Items -->
	<section class="specialty-items">
		<div class="container">
			<h2>Specialty Items</h2>
			<div class="specialty-grid">
				<div class="specialty-item">
					<div class="specialty-icon">🛏️</div>
					<h3>Comforters</h3>
					<p class="specialty-price">Separate quote</p>
					<p class="specialty-note">Twin, full/queen, king, and weighted blankets</p>
				</div>
				<div class="specialty-item">
					<div class="specialty-icon">⚖️</div>
					<h3>Weighted Blankets</h3>
					<p class="specialty-price">Separate quote</p>
				</div>
				<div class="specialty-item">
					<div class="specialty-icon">🛌</div>
					<h3>Pillows</h3>
					<p class="specialty-price">Separate quote</p>
					<p class="specialty-note">Pillows and delicate items</p>
				</div>
				<div class="specialty-item">
					<div class="specialty-icon">🐕</div>
					<h3>Pet Beds</h3>
					<p class="specialty-price">Separate quote</p>
					<p class="specialty-note">Small and large pet beds</p>
				</div>
				<div class="specialty-item">
					<div class="specialty-icon">🧶</div>
					<h3>Rugs</h3>
					<p class="specialty-price">Separate quote</p>
					<p class="specialty-note">Rugs and custom items</p>
				</div>
				<div class="specialty-item">
					<div class="specialty-icon">🛁</div>
					<h3>Bath Mats</h3>
					<p class="specialty-price">Separate quote</p>
					<p class="specialty-note">Bath mats and mattress protectors</p>
				</div>
			</div>
			<p class="pricing-note">Specialty items are priced separately. Final price may be confirmed after pickup and inspection.</p>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="pricing-cta">
		<div class="container">
			<div class="cta-content">
				<h2>Ready to experience our service?</h2>
				<p>Book your first pickup or start a subscription today.</p>
				<div class="cta-buttons">
					<a href="/book-pickup" class="btn btn-primary">Book Pickup</a>
					<a href="/subscriptions" class="btn btn-secondary">View Subscriptions</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	.hero {
		background: linear-gradient(135deg, #f0f4f8 0%, #e8f2f8 100%);
		padding: 60px 0;
		text-align: center;
	}

	.hero h1 {
		color: #001f3f;
		margin-bottom: 15px;
	}

	.hero p {
		color: #666;
		font-size: 1.1rem;
		max-width: 600px;
		margin: 0 auto;
	}

	.pricing-services {
		padding: 60px 0;
	}

	.pricing-services h2 {
		text-align: center;
		color: #001f3f;
		margin-bottom: 10px;
	}

	.section-subtitle {
		text-align: center;
		color: #666;
		margin-bottom: 40px;
		font-size: 1.05rem;
	}

	.pricing-cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 25px;
		margin-bottom: 40px;
	}

	.pricing-card {
		background: white;
		padding: 30px;
		border-radius: 8px;
		border: 2px solid transparent;
		text-align: center;
		position: relative;
		transition: all 0.3s;
		box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
	}

	.pricing-card:hover {
		transform: translateY(-10px);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
	}

	.pricing-card.featured {
		border-color: #00a0c6;
		background: linear-gradient(135deg, #f0f4f8 0%, #e8f2f8 100%);
		transform: scale(1.05);
	}

	.service-icon {
		font-size: 2.5rem;
		margin-bottom: 15px;
	}

	.pricing-card h3 {
		color: #001f3f;
		margin-bottom: 10px;
	}

	.price {
		font-size: 2rem;
		font-weight: 700;
		color: #00a0c6;
		margin-bottom: 10px;
	}

	.price span {
		font-size: 1rem;
		color: #666;
		font-weight: 500;
	}

	.pricing-card p {
		color: #666;
		font-size: 0.95rem;
	}

	.badge {
		position: absolute;
		top: 15px;
		left: 50%;
		transform: translateX(-50%);
		background-color: #00a0c6;
		color: white;
		padding: 6px 12px;
		border-radius: 20px;
		font-size: 0.75rem;
		font-weight: 600;
	}

	.delivery-pricing {
		background-color: #f9f9f9;
		padding: 60px 0;
	}

	.delivery-pricing h2 {
		text-align: center;
		color: #001f3f;
		margin-bottom: 40px;
	}

	.delivery-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 20px;
		margin-bottom: 30px;
	}

	.delivery-item {
		background: white;
		padding: 20px;
		border-radius: 8px;
		text-align: center;
		border: 1px solid #e0e0e0;
	}

	.delivery-item .icon {
		font-size: 2rem;
		margin-bottom: 10px;
		display: block;
	}

	.delivery-item h4 {
		color: #001f3f;
		margin-bottom: 10px;
		font-size: 1rem;
	}

	.delivery-item .price {
		font-size: 1rem;
		font-weight: 700;
		color: #00a0c6;
		margin: 0;
	}

	.formula-box {
		background: white;
		border: 1px solid #d8e8ef;
		border-radius: 8px;
		padding: 24px;
		max-width: 900px;
		margin: 0 auto 24px;
	}

	.formula-box h3 {
		color: #001f3f;
		margin-bottom: 10px;
	}

	.formula-box p {
		color: #555;
		line-height: 1.7;
		margin-bottom: 8px;
	}

	.pricing-note {
		text-align: center;
		color: #999;
		font-size: 0.9rem;
	}

	.add-ons {
		padding: 60px 0;
	}

	.add-ons h2 {
		text-align: center;
		color: #001f3f;
		margin-bottom: 40px;
	}

	.addons-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 20px;
	}

	.addon-item {
		background: white;
		padding: 20px;
		border-radius: 8px;
		text-align: center;
		border: 1px solid #e0e0e0;
	}

	.addon-icon {
		font-size: 2rem;
		display: block;
		margin-bottom: 10px;
	}

	.addon-item h4 {
		color: #001f3f;
		margin-bottom: 10px;
		font-size: 0.95rem;
	}

	.addon-price {
		color: #00a0c6;
		font-weight: 700;
		margin: 0;
	}

	.specialty-items {
		background-color: #f9f9f9;
		padding: 60px 0;
	}

	.specialty-items h2 {
		text-align: center;
		color: #001f3f;
		margin-bottom: 40px;
	}

	.specialty-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 25px;
	}

	.specialty-item {
		background: white;
		padding: 20px;
		border-radius: 8px;
		text-align: center;
	}

	.specialty-icon {
		font-size: 2.5rem;
		margin-bottom: 10px;
		display: block;
	}

	.specialty-item h3 {
		color: #001f3f;
		margin-bottom: 10px;
		font-size: 1rem;
	}

	.specialty-price {
		font-size: 1.3rem;
		font-weight: 700;
		color: #00a0c6;
		margin-bottom: 5px;
	}

	.specialty-note {
		color: #999;
		font-size: 0.85rem;
		margin: 0;
	}

	.pricing-cta {
		padding: 80px 0;
		background: linear-gradient(135deg, #0066a1 0%, #00a0c6 100%);
		color: white;
		text-align: center;
	}

	.pricing-cta h2 {
		color: white;
		margin-bottom: 10px;
	}

	.pricing-cta p {
		font-size: 1.1rem;
		margin-bottom: 30px;
		opacity: 0.95;
	}

	.cta-buttons {
		display: flex;
		gap: 15px;
		justify-content: center;
		flex-wrap: wrap;
	}

	.cta-buttons .btn {
		min-width: 180px;
	}

	@media (max-width: 768px) {
		.hero h1 {
			font-size: 1.8rem;
		}

		.pricing-card.featured {
			transform: scale(1);
		}

		.pricing-cards {
			gap: 15px;
		}

		.specialty-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.cta-buttons {
			flex-direction: column;
		}

		.cta-buttons .btn {
			min-width: auto;
		}
	}
</style>
