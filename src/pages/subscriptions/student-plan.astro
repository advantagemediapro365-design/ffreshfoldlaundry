---
import SubscriptionPlanDetail from '../../components/SubscriptionPlanDetail.astro';
---

<SubscriptionPlanDetail
	planName="Fresh Starter"
	planSlug="student-plan"
	monthlyPrice="$79"
	includedPounds="40 lb/month"
	overageRate="$1.75/lb"
	idealFor="Individuals and customers with light laundry loads"
	description="A simple recurring plan with two monthly pickups for lighter laundry loads."
	canonicalPath="/subscriptions/student-plan"
	highlights={[
		'Best for dorms, apartments, and lighter weekly laundry loads.',
		'Includes a monthly allowance that fits students and parent-paid plans.',
		'You only pay extra when your laundry goes over the included monthly pounds.'
	]}
	howItWorks={[
		'Choose a recurring pickup day that fits your routine.',
		'Leave your laundry out and we handle the wash, dry, and fold service.',
		'Any laundry above your monthly included pounds is billed at the overage rate.'
	]}
	whoItFits={[
		'Students who want predictable weekly service with less hassle.',
		'Parents managing a student’s laundry and budget.',
		'Customers who usually stay around 60 lb or less each month.'
	]}
/>
