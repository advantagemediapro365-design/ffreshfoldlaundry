---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Accessibility Statement | Fresh Fold Delivery"
	description="Accessibility Statement for Fresh Fold Delivery. We are committed to making our website accessible and usable for all visitors, including people with disabilities."
	canonicalPath="/accessibility"
>
	<!-- Hero Section -->
	<section class="hero">
		<div class="container">
			<div class="hero-content">
				<div class="hero-text">
					<h1>Accessibility Statement</h1>
					<p>Fresh Fold Delivery is committed to making our website accessible and usable for all visitors, including people with disabilities.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Accessibility Content -->
	<section class="accessibility-content">
		<div class="container">
			<div class="content-wrapper">
				<div class="content-main">
					<h2>Our Commitment</h2>
					<p>
						We are committed to making our website accessible and usable for all visitors, including people with disabilities. We are actively working to follow recognized web accessibility standards, including <strong>WCAG 2.2 Level AA</strong> guidelines, and to improve the user experience for everyone.
					</p>

					<h2>What We Are Doing</h2>
					<ul>
						<li>Building our website with semantic HTML structure</li>
						<li>Ensuring all interactive elements are keyboard accessible</li>
						<li>Providing descriptive alt text for all meaningful images</li>
						<li>Using clear headings and logical page structure</li>
						<li>Maintaining proper color contrast ratios</li>
						<li>Making all forms accessible with clear labels and instructions</li>
						<li>Testing with assistive technologies including screen readers</li>
						<li>Ensuring mobile accessibility for all devices</li>
						<li>Continuously testing and improving accessibility features</li>
					</ul>

					<h2>How to Request Assistance</h2>
					<p>
						If you experience difficulty accessing any part of this website, please contact us at:
					</p>
					<ul>
						<li><strong>Phone:</strong> 570-494-7523</li>
						<li><strong>Email:</strong> info@freshfoldaltoona.com</li>
					</ul>
					<p>
						We will make reasonable efforts to assist you and provide the information, service, or transaction you need through an accessible method.
					</p>

					<h2>Third-Party Services</h2>
					<p>
						This website uses various third-party services and integrations. We work with our service providers to ensure they meet accessibility standards where possible.
					</p>

					<h2>Standards and Guidelines</h2>
					<p>
						Our website aims to comply with the <strong>Web Content Accessibility Guidelines (WCAG) 2.2 Level AA</strong>, published by the Web Accessibility Initiative (WAI) of the World Wide Web Consortium (W3C).
					</p>

					<h2>Feedback</h2>
					<p>
						We welcome your feedback on the accessibility of our website. Please let us know if you encounter any accessibility issues so we can work to improve your experience.
					</p>

					<h2>Last Updated</h2>
					<p>This accessibility statement was last updated on June 18, 2026.</p>
				</div>

				<aside class="sidebar">
					<div class="sidebar-box">
						<h3>Quick Links</h3>
						<ul>
							<li><a href="/accessibility#need-help">Need Help?</a></li>
							<li><a href="/contact">Contact Us</a></li>
							<li><a href="/privacy-policy">Privacy Policy</a></li>
							<li><a href="/terms-of-service">Terms of Service</a></li>
						</ul>
					</div>

					<div class="sidebar-box">
						<h3>Accessibility Resources</h3>
						<ul>
							<li><a href="https://www.w3.org/WAI/WCAG22/quickref/" target="_blank" rel="noopener">WCAG 2.2 Guidelines</a></li>
							<li><a href="https://www.ada.gov/resources/web-accessibility-guide/" target="_blank" rel="noopener">ADA Web Accessibility</a></li>
							<li><a href="https://www.section508.gov/" target="_blank" rel="noopener">Section 508 Standards</a></li>
						</ul>
					</div>
				</aside>
			</div>
		</div>
	</section>

	<!-- Contact Section -->
	<section id="need-help" class="contact-section">
		<div class="container">
			<h2>We're Here to Help</h2>
			<p>Have accessibility questions or concerns? Get in touch with us.</p>
			<div class="contact-options">
				<div class="contact-option">
					<h3>Call or Text</h3>
					<p><a href="tel:+1-570-494-7523">570-494-7523</a></p>
				</div>
				<div class="contact-option">
					<h3>Email</h3>
					<p><a href="mailto:info@freshfoldaltoona.com">info@freshfoldaltoona.com</a></p>
				</div>
				<div class="contact-option">
					<h3>Contact Form</h3>
					<p><a href="/contact">Send us a message</a></p>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	.hero {
		background: linear-gradient(135deg, #0066a1 0%, #00a0c6 100%);
		color: white;
		padding: 60px 0;
		margin-bottom: 40px;
	}

	.hero-content {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 40px;
	}

	.hero-text {
		flex: 1;
	}

	.hero-text h1 {
		font-size: 2.5rem;
		margin-bottom: 20px;
		line-height: 1.2;
	}

	.hero-text p {
		font-size: 1.1rem;
		line-height: 1.6;
		opacity: 0.95;
	}

	.accessibility-content {
		padding: 60px 0;
		background-color: #f8f9fa;
	}

	.content-wrapper {
		display: grid;
		grid-template-columns: 1fr 300px;
		gap: 40px;
	}

	.content-main {
		background: white;
		padding: 40px;
		border-radius: 8px;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
	}

	.content-main h2 {
		font-size: 1.6rem;
		margin-top: 40px;
		margin-bottom: 20px;
		color: #0066a1;
	}

	.content-main h2:first-child {
		margin-top: 0;
	}

	.content-main p {
		line-height: 1.6;
		margin-bottom: 15px;
		color: #333;
	}

	.content-main ul {
		margin-left: 20px;
		margin-bottom: 20px;
	}

	.content-main li {
		margin-bottom: 10px;
		line-height: 1.6;
		color: #333;
	}

	.content-main a {
		color: #0066a1;
		text-decoration: none;
		font-weight: 500;
	}

	.content-main a:hover {
		text-decoration: underline;
	}

	.sidebar {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.sidebar-box {
		background: white;
		padding: 20px;
		border-radius: 8px;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
	}

	.sidebar-box h3 {
		font-size: 1.2rem;
		color: #0066a1;
		margin-bottom: 15px;
	}

	.sidebar-box ul {
		list-style: none;
		padding: 0;
	}

	.sidebar-box li {
		margin-bottom: 10px;
	}

	.sidebar-box a {
		color: #0066a1;
		text-decoration: none;
		display: block;
		padding: 5px 0;
	}

	.sidebar-box a:hover {
		text-decoration: underline;
	}

	.contact-section {
		padding: 60px 0;
		background-color: white;
		text-align: center;
	}

	.contact-section h2 {
		font-size: 2rem;
		color: #0066a1;
		margin-bottom: 20px;
	}

	.contact-section p {
		font-size: 1.1rem;
		margin-bottom: 40px;
		color: #666;
	}

	.contact-options {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 30px;
		margin-top: 30px;
	}

	.contact-option {
		background: #f8f9fa;
		padding: 30px;
		border-radius: 8px;
		border: 1px solid #e0e0e0;
	}

	.contact-option h3 {
		font-size: 1.2rem;
		color: #0066a1;
		margin-bottom: 15px;
	}

	.contact-option p {
		margin: 0;
	}

	.contact-option a {
		color: #0066a1;
		text-decoration: none;
		font-weight: 500;
		font-size: 1.1rem;
	}

	.contact-option a:hover {
		text-decoration: underline;
	}

	@media (max-width: 768px) {
		.hero-content {
			flex-direction: column;
		}

		.hero-text h1 {
			font-size: 1.8rem;
		}

		.content-wrapper {
			grid-template-columns: 1fr;
		}

		.content-main {
			padding: 20px;
		}

		.contact-options {
			grid-template-columns: 1fr;
		}
	}
</style>
