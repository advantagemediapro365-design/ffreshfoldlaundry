---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Commercial Laundry Service in Central PA | Fresh Fold Delivery"
	description="Fresh Fold Delivery offers commercial laundry pickup and delivery in Central PA for salons, spas, gyms, restaurants, rentals, hotels, and high-volume accounts."
	canonicalPath="/commercial-laundry"
>
	<!-- Hero Section -->
	<section class="hero">
		<div class="container">
			<div class="hero-content">
				<div class="hero-text">
					<h1>Commercial Laundry Pickup & Delivery</h1>
					<p class="tagline">Reliable. Consistent. Professional.</p>
					<p>Fresh Fold Delivery provides clean, neatly folded linens and towels your business can count on. We help local teams save time, reduce laundry strain, and keep customers coming back.</p>
					<div class="hero-buttons">
						<a href="/contact" class="btn btn-primary">Get Commercial Quote</a>
						<a href="/pricing" class="btn btn-secondary">View Pricing</a>
					</div>
				</div>
				<div class="hero-image">
					<div class="placeholder-image">
						<img src="/images/freshfold-commercial-hero.png" alt="FreshFold Laundry & Delivery Logo"  />
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Service Area Info -->
	<section class="service-info">
		<div class="container">
			<div class="info-box">
				<p>📍 <strong>Serving Altoona and Surrounding Areas</strong></p>
				<p>Daily in Altoona & State College • Weekly route to Lock Haven</p>
				<p>Active service in Altoona &amp; State College • weekly Lock Haven route • route-based service across Centre County, Blair County, and nearby Central PA towns. <a href="/service-areas#zipcode">Check your ZIP</a>.</p>
			</div>
		</div>
	</section>

	<!-- We Serve -->
	<section class="we-serve">
		<div class="container">
			<h2>We Proudly Serve Businesses Like Yours</h2>
			<div class="service-types">
				<div class="type-card">
					<div class="icon" aria-hidden="true">💇</div>
					<h3>Salons & Spas</h3>
					<p>Towels, capes, robes—always fresh and ready.</p>
				</div>
				<div class="type-card">
					<div class="icon" aria-hidden="true">💪</div>
					<h3>Gyms & Fitness Centers</h3>
					<p>Towels and workout linens cleaned to high standards.</p>
				</div>
				<div class="type-card">
					<div class="icon" aria-hidden="true">🍽️</div>
					<h3>Restaurants</h3>
					<p>Table linens, napkins, cook uniforms and kitchen towels.</p>
				</div>
				<div class="type-card">
					<div class="icon" aria-hidden="true">🏠</div>
					<h3>Airbnb & Short-Term Rentals</h3>
					<p>Fresh linens for guaranteed guest satisfaction.</p>
				</div>
				<div class="type-card">
					<div class="icon" aria-hidden="true">🛏️</div>
					<h3>Rental Properties</h3>
					<p>Bulk laundry solutions for turnover rentals.</p>
				</div>
				<div class="type-card">
					<div class="icon" aria-hidden="true">✂️</div>
					<h3>Barbershops</h3>
					<p>Capes, towels and linens cleaned with care.</p>
				</div>
				<div class="type-card">
					<div class="icon" aria-hidden="true">🧖</div>
					<h3>Massage Therapists</h3>
					<p>Sheets, towels and linens cleaned to your specifications.</p>
				</div>
				<div class="type-card">
					<div class="icon" aria-hidden="true">🏨</div>
					<h3>Small Hotels & Inns</h3>
					<p>Consistent, reliable service for all your linens.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Features -->
	<section class="features">
		<div class="container">
			<h2>Why Choose Fresh Fold for Your Business?</h2>
			<div class="features-grid">
				<div class="feature">
					<div class="feature-icon" aria-hidden="true">📅</div>
					<h3>Reliable Pickup Schedules</h3>
					<p>Consistent, on-time service you can depend on.</p>
				</div>
				<div class="feature">
					<div class="feature-icon" aria-hidden="true">🛡️</div>
					<h3>Route Consistency</h3>
					<p>Same drivers, same standards, every time.</p>
				</div>
				<div class="feature">
					<div class="feature-icon" aria-hidden="true">✨</div>
					<h3>Custom Folding & Sorting</h3>
					<p>We follow your linens according to your specifications.</p>
				</div>
				<div class="feature">
					<div class="feature-icon" aria-hidden="true">💼</div>
					<h3>Account Management & Billing</h3>
					<p>Easy invoicing and reliable account management.</p>
				</div>
				<div class="feature">
					<div class="feature-icon" aria-hidden="true">📞</div>
					<h3>Local & Dedicated Support</h3>
					<p>Our team is here to support your needs.</p>
				</div>
				<div class="feature">
					<div class="feature-icon" aria-hidden="true">🌍</div>
					<h3>Eco-Friendly Operations</h3>
					<p>Better for you & the planet we share.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Pricing -->
	<section class="pricing">
		<div class="container">
			<h2>Simple, Transparent Pricing</h2>
			<p class="pricing-subtitle">Commercial laundry is quoted by volume, schedule, item mix, route availability, and care requirements.</p>
			<div class="pricing-grid">
				<div class="pricing-card">
					<h3>Business Starter</h3>
					<p class="price">Custom<span> quote</span></p>
					<p>100-299 lb</p>
					<p>Weekly pickup</p>
					<button class="btn btn-primary">Get Started</button>
				</div>
				<div class="pricing-card">
					<h3>Business Growth</h3>
					<p class="price">Custom<span> quote</span></p>
					<p>300-699 lb</p>
					<p>2x Weekly pickup</p>
					<button class="btn btn-primary">Get Started</button>
				</div>
				<div class="pricing-card featured">
					<div class="badge">Popular</div>
					<h3>Business Pro</h3>
					<p class="price">Custom<span> quote</span></p>
					<p>700-999 lb</p>
					<p>2x Weekly pickup</p>
					<button class="btn btn-primary">Get Started</button>
				</div>
				<div class="pricing-card">
					<h3>Enterprise</h3>
					<p class="price">Custom</p>
					<p>1,000+ lb</p>
					<p>Custom schedule</p>
					<button class="btn btn-secondary">Contact Us</button>
				</div>
			</div>
			<p class="pricing-note">Delivery is quoted separately unless a written agreement or approved promotion says otherwise.</p>
		</div>
	</section>

	<!-- Process -->
	<section class="process">
		<div class="container">
			<h2>Our Simple Process</h2>
			<div class="process-steps">
				<div class="process-step">
					<div class="step-number">1</div>
					<h3>Pickup</h3>
					<p>We pick up your laundry on your schedule. Linens on your premises.</p>
				</div>
				<div class="arrow">→</div>
				<div class="process-step">
					<div class="step-number">2</div>
					<h3>Weigh & Inspect</h3>
					<p>We weigh your laundry and inspect for any needed care.</p>
				</div>
				<div class="arrow">→</div>
				<div class="process-step">
					<div class="step-number">3</div>
					<h3>Clean & Sanitize</h3>
					<p>Washed with care, detergents and high standards.</p>
				</div>
				<div class="arrow">→</div>
				<div class="process-step">
					<div class="step-number">4</div>
					<h3>Fold & Package</h3>
					<p>Professionally folded and packaged to your preferences.</p>
				</div>
				<div class="arrow">→</div>
				<div class="process-step">
					<div class="step-number">5</div>
					<h3>Return & Deliver</h3>
					<p>Delivered back on time, clean and ready for use.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Customer feedback will be shown here only after verified reviews are approved. -->
	<section class="testimonials" aria-labelledby="commercial-proof-heading">
		<div class="container">
			<h2 id="commercial-proof-heading">Commercial service details</h2>
			<p>Request a quote to discuss your volume, item types, route, schedule, and care requirements. Customer reviews will be added only after they are verified and approved.</p>
		</div>
	</section>

	<!-- Form Section -->
	<section class="quote-section">
		<div class="container">
			<div class="quote-box">
				<div class="quote-text">
					<h2>Get a Custom Quote</h2>
					<p>Tell us about your business and laundry needs. We'll create a custom solution that works for you.</p>
				</div>
				<form class="quote-form">
					<div class="form-group">
						<label>Business Name</label>
						<input type="text" placeholder="Enter your business name" />
					</div>
					<div class="form-group">
						<label>Contact Name</label>
						<input type="text" placeholder="Your full name" />
					</div>
					<div class="form-group">
						<label>Email</label>
						<input type="email" placeholder="you@example.com" />
					</div>
					<div class="form-group">
						<label>Service Type</label>
						<select>
							<option>Select a service type</option>
							<option>Salon & Spa</option>
							<option>Restaurant</option>
							<option>Gym & Fitness</option>
							<option>Airbnb & Rentals</option>
							<option>Hotel & Inns</option>
							<option>Barbershop</option>
							<option>Other</option>
						</select>
					</div>
					<div class="form-group">
						<label>Estimated Weekly Pounds</label>
						<select>
							<option>Select estimated weight</option>
							<option>100-299 lbs</option>
							<option>300-699 lbs</option>
							<option>700-999 lbs</option>
							<option>1,000+ lbs</option>
						</select>
					</div>
					<div class="form-group">
						<label>Message</label>
						<textarea placeholder="Tell us about your laundry needs..." rows="4"></textarea>
					</div>
					<button type="submit" class="btn btn-primary" style="width: 100%;">Request Quote</button>
				</form>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="final-cta">
		<div class="container">
			<h2>High-Volume Laundry? We've Got You Covered.</h2>
			<p>From 100 to 1,000+ lbs per week, we provide scalable solutions that grow with your business.</p>
			<a href="#" class="btn btn-primary" style="font-size: 1.1rem; padding: 15px 40px;">Get a Custom Quote</a>
			<p class="cta-phone">or call 570-494-7523</p>
		</div>
	</section>
</Layout>

<style>
	.hero {
		background: linear-gradient(135deg, #f0f4f8 0%, #e8f2f8 100%);
		padding: 60px 0;
	}

	.hero-content {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 50px;
		align-items: center;
	}

	.hero-text h1 {
		color: #001f3f;
		margin-bottom: 10px;
	}

	.tagline {
		font-size: 1.2rem;
		color: #00a0c6;
		font-weight: 600;
		margin-bottom: 15px;
	}

	.hero-text p {
		color: #666;
		font-size: 1rem;
		line-height: 1.8;
		margin-bottom: 10px;
	}

	.hero-buttons {
		display: flex;
		gap: 15px;
		margin-top: 25px;
		flex-wrap: wrap;
	}

	.placeholder-image {
		width: 100%;
		aspect-ratio: 1;
		background: linear-gradient(135deg, #e8f2f8 0%, #d4e6f1 100%);
		border-radius: 8px;
	}
	.placeholder-image img {
		width: 100%;
		height: 100%;	
	}
	.service-info {
		padding: 20px 0;
		background-color: white;
		text-align: center;
	}

	.info-box {
		background: #f0f4f8;
		padding: 15px 20px;
		border-radius: 6px;
		border-left: 4px solid #00a0c6;
	}

	.info-box p {
		color: #666;
		margin: 5px 0;
	}

	.we-serve {
		padding: 60px 0;
	}

	.we-serve h2 {
		text-align: center;
		color: #001f3f;
		margin-bottom: 40px;
	}

	.service-types {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 20px;
	}

	.type-card {
		background: white;
		padding: 25px;
		border-radius: 8px;
		text-align: center;
		border: 1px solid #e0e0e0;
		transition: all 0.3s;
	}

	.type-card:hover {
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
		transform: translateY(-5px);
	}

	.type-card .icon {
		font-size: 2.5rem;
		margin-bottom: 10px;
		display: block;
	}

	.type-card h3 {
		color: #001f3f;
		margin-bottom: 8px;
		font-size: 1rem;
	}

	.type-card p {
		color: #666;
		font-size: 0.9rem;
	}

	.features {
		background-color: #f9f9f9;
		padding: 60px 0;
	}

	.features h2 {
		text-align: center;
		color: #001f3f;
		margin-bottom: 40px;
	}

	.features-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 30px;
	}

	.feature {
		text-align: center;
	}

	.feature-icon {
		font-size: 2.5rem;
		margin-bottom: 15px;
		display: block;
	}

	.feature h3 {
		color: #001f3f;
		margin-bottom: 8px;
	}

	.feature p {
		color: #666;
		font-size: 0.95rem;
	}

	.pricing {
		padding: 60px 0;
	}

	.pricing h2 {
		text-align: center;
		color: #001f3f;
		margin-bottom: 10px;
	}

	.pricing-subtitle {
		text-align: center;
		color: #666;
		margin-bottom: 40px;
	}

	.pricing-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 25px;
		margin-bottom: 20px;
	}

	.pricing-card {
		background: white;
		padding: 30px;
		border-radius: 8px;
		border: 2px solid transparent;
		text-align: center;
		transition: all 0.3s;
		position: relative;
		box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
	}

	.pricing-card:hover {
		transform: translateY(-10px);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
	}

	.pricing-card.featured {
		border-color: #00a0c6;
		background: linear-gradient(135deg, #f0f4f8 0%, #e8f2f8 100%);
	}

	.pricing-card h3 {
		color: #001f3f;
		margin-bottom: 10px;
	}

	.price {
		font-size: 1.8rem;
		font-weight: 700;
		color: #00a0c6;
		margin-bottom: 10px;
	}

	.price span {
		font-size: 1rem;
		color: #666;
		font-weight: 500;
	}

	.pricing-card p {
		color: #666;
		margin-bottom: 8px;
	}

	.badge {
		position: absolute;
		top: 15px;
		left: 50%;
		transform: translateX(-50%);
		background-color: #00a0c6;
		color: white;
		padding: 6px 12px;
		border-radius: 20px;
		font-size: 0.75rem;
		font-weight: 600;
	}

	.pricing-note {
		text-align: center;
		color: #999;
		font-size: 0.9rem;
	}

	.process {
		background-color: #f0f4f8;
		padding: 60px 0;
	}

	.process h2 {
		text-align: center;
		color: #001f3f;
		margin-bottom: 40px;
	}

	.process-steps {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 15px;
		align-items: center;
	}

	.process-step {
		text-align: center;
	}

	.step-number {
		width: 60px;
		height: 60px;
		background-color: #00a0c6;
		color: white;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 700;
		font-size: 1.5rem;
		margin: 0 auto 15px;
	}

	.process-step h3 {
		color: #001f3f;
		margin-bottom: 8px;
		font-size: 1rem;
	}

	.process-step p {
		color: #666;
		font-size: 0.85rem;
	}

	.arrow {
		text-align: center;
		color: #999;
		font-size: 1.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.testimonials {
		padding: 60px 0;
	}

	.testimonials h2 {
		text-align: center;
		color: #001f3f;
		margin-bottom: 40px;
	}

	.testimonials-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 30px;
	}

	.testimonial {
		background: white;
		padding: 25px;
		border-radius: 8px;
		border-left: 4px solid #00a0c6;
		box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
	}

	.testimonial .stars {
		font-size: 1.1rem;
		margin-bottom: 15px;
	}

	.testimonial p {
		color: #666;
		margin-bottom: 10px;
		line-height: 1.6;
	}

	.testimonial .author {
		font-weight: 600;
		color: #333;
	}

	.quote-section {
		background-color: #f9f9f9;
		padding: 60px 0;
	}

	.quote-box {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 40px;
		background: white;
		padding: 40px;
		border-radius: 8px;
		box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
	}

	.quote-text h2 {
		color: #001f3f;
		margin-bottom: 15px;
	}

	.quote-text p {
		color: #666;
		line-height: 1.8;
	}

	.quote-form {
		display: flex;
		flex-direction: column;
		gap: 15px;
	}

	.form-group {
		display: flex;
		flex-direction: column;
	}

	.form-group label {
		color: #333;
		font-weight: 600;
		margin-bottom: 5px;
	}

	.form-group input,
	.form-group select,
	.form-group textarea {
		padding: 12px 15px;
		border: 1px solid #e0e0e0;
		border-radius: 6px;
		font-size: 1rem;
		font-family: inherit;
	}

	.final-cta {
		background: linear-gradient(135deg, #0066a1 0%, #00a0c6 100%);
		color: white;
		text-align: center;
		padding: 80px 0;
	}

	.final-cta h2 {
		color: white;
		margin-bottom: 15px;
	}

	.final-cta p {
		font-size: 1.1rem;
		margin-bottom: 20px;
		opacity: 0.95;
	}

	.cta-phone {
		margin-top: 15px;
		font-size: 1rem;
	}

	@media (max-width: 768px) {
		.hero-content {
			grid-template-columns: 1fr;
			gap: 30px;
		}

		.hero-buttons {
			flex-direction: column;
		}

		.process-steps {
			grid-template-columns: 1fr;
		}

		.arrow {
			display: none;
		}

		.quote-box {
			grid-template-columns: 1fr;
		}

		.quote-text h2 {
			font-size: 1.8rem;
		}

		.service-types {
			grid-template-columns: 1fr;
		}

		.final-cta {
			padding: 40px 0;
		}

		.final-cta h2 {
			font-size: 1.8rem;
		}
	}

	/* Sales-page treatment from the supplied commercial reference. */
	.hero { padding:34px 0 26px; background:linear-gradient(90deg,#fff 0%,rgba(255,255,255,.86) 54%,rgba(234,247,251,.5)),url('/images/freshfold-commercial-hero.png') right center/52% auto no-repeat; }
	.hero-content { grid-template-columns:1.08fr .92fr; gap:28px; }
	.hero-text h1 { font-size:clamp(2.4rem,5vw,4rem); }
	.hero-image .placeholder-image { aspect-ratio:1.15; border-radius:14px; overflow:hidden; box-shadow:0 8px 24px rgba(15,39,66,.12); }
	.hero-image .placeholder-image img { object-fit:cover; }
	.service-info { padding:14px 0; background:#fff; }
	.info-box { border:1px solid var(--border); border-left:4px solid var(--secondary); background:#f1fbfd; border-radius:8px; }
	.we-serve { padding:34px 0; }
	.service-types { grid-template-columns:repeat(4,1fr); gap:12px; }
	.type-card { padding:18px 14px; border-color:var(--border); border-radius:10px; box-shadow:0 4px 13px rgba(15,39,66,.05); }
	.type-card .icon { color:var(--secondary); font-size:2rem; }
	.features { padding:34px 0; background:#f7fbfd; }
	.features-grid { grid-template-columns:repeat(3,1fr); gap:14px; }
	.feature { padding:18px; border:1px solid var(--border); border-radius:9px; background:#fff; }
	.feature-icon { color:var(--secondary); font-size:2rem; }
	.pricing { padding:38px 0; }
	.pricing-grid { grid-template-columns:repeat(4,1fr); gap:14px; }
	.pricing-card { padding:23px 16px; border-color:var(--border); border-radius:10px; box-shadow:0 4px 14px rgba(15,39,66,.06); }
	.pricing-card.featured { border-color:var(--secondary); background:#effafd; }
	.process { padding:34px 0; background:#f1fbfd; }
	.process-steps { grid-template-columns:repeat(9,1fr); gap:8px; }
	.process-step:nth-of-type(odd) { grid-column:span 1; }.process-steps .arrow { grid-column:span 1; }
	.testimonials { padding:38px 0; }
	.testimonial { border:1px solid var(--border); border-left:0; border-radius:10px; box-shadow:0 4px 13px rgba(15,39,66,.05); }
	.quote-section { padding:38px 0; background:#f7fbfd; }
