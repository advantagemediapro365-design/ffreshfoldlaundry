---
import Layout from '../layouts/Layout.astro';
import { getZipAvailability, SERVICE_AREA_GROUPS } from '../lib/zipAvailability.js';

const availabilityMessage = 'Enter your ZIP code to check whether we offer daily service, weekly route service, or route-based pickup in your area.';
---

<Layout
	title="Laundry Pickup & Delivery Service Areas | Fresh Fold Laundry Delivery Altoona"
	description="Fresh Fold Laundry Delivery Altoona serves Altoona, State College, Lock Haven, Blair County, and nearby Central Pennsylvania towns through daily, weekly, and route-based pickup."
	canonicalPath="/service-areas"
>
	<!-- Hero Section -->
	<section class="hero">
		<div class="container">
			<h1>Fresh Fold Delivery Service Areas</h1>
			<p>Fresh Fold Delivery currently offers daily service in Altoona and State College, weekly route service in Lock Haven, and route-based availability across Blair County and nearby Central Pennsylvania communities.</p>
			<div class="hero-actions">
				<a href="#zipcode" class="btn btn-primary">Check My ZIP Code</a>
				<a href="/book-pickup" class="btn btn-secondary">Book Pickup</a>
			</div>
		</div>
	</section>

	<!-- Complete ZIP Coverage -->
	<section class="zip-coverage">
		<div class="container">
			<h2>Service Areas &amp; ZIP Codes</h2>
			<p class="coverage-intro">Daily service is currently advertised only for Altoona and State College. Lock Haven is weekly. All other listed locations are route-based and must be confirmed by schedule.</p>
			<div class="coverage-grid">
				{SERVICE_AREA_GROUPS.map((group) => <article class={`coverage-card ${group.status}`}><h3>{group.region}</h3><div class="coverage-list">{group.areas.map(([town, zips]) => <p><strong>{town}</strong><span>{zips}</span></p>)}</div></article>)}
			</div>
			<p class="po-box-note"><strong>Physical address required:</strong> 16603, 16804, and 16805 are P.O. Box ZIPs and cannot be used as physical pickup addresses.</p>
		</div>
	</section>

	<!-- Service Map -->
	<section class="service-map">
		<div class="container">
			<div class="map-container">
				<iframe title="Fresh Fold service area from Altoona to Lock Haven" src="https://www.openstreetmap.org/export/embed.html?bbox=-78.75%2C40.80%2C-77.30%2C41.35&amp;layer=mapnik&amp;marker=40.81%2C-78.40" loading="lazy"></iframe>
				<div class="service-locations">
					<div class="location">Lock Haven - Weekly Route</div>
					<div class="location">State College - Daily Service</div>
					<div class="location">Altoona - Daily Service</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Service Areas -->
	<section class="service-areas">
		<div class="container">
			<div class="areas-grid">
				<!-- Altoona -->
				<div class="area-card">
					<div class="area-icon">🏙️</div>
					<h3>Altoona</h3>
					<p class="area-service">Daily Service</p>
					<ul class="area-features">
						<li>Daily pickup and delivery available</li>
						<li>Altoona / 16601 route area</li>
						<li>Nearby areas by route schedule</li>
					</ul>
					<p class="area-hub"><strong>Primary Hub</strong></p>
				</div>

				<!-- State College -->
				<div class="area-card">
					<div class="area-icon">🎓</div>
					<h3>State College</h3>
					<p class="area-service">Daily Service</p>
					<ul class="area-features">
						<li>Daily pickup and delivery available</li>
						<li>State College / 16801 route areas</li>
						<li>Student and household plans available</li>
					</ul>
					<p class="area-hub"><strong>Primary Hub</strong></p>
				</div>

				<!-- Lock Haven -->
				<div class="area-card">
					<div class="area-icon">🛣️</div>
					<h3>Lock Haven</h3>
					<p class="area-service">Weekly Route</p>
					<ul class="area-features">
						<li>Weekly laundry pickup and delivery route</li>
						<li>Lock Haven / 17745 weekly route</li>
						<li>No daily service advertised yet</li>
					</ul>
					<p class="area-hub"><strong>Weekly Route</strong></p>
				</div>

				<!-- Nearby Areas -->
				<div class="area-card">
					<div class="area-icon">📍</div>
					<h3>Blair County & Nearby Towns</h3>
					<p class="area-service">Route-Based</p>
					<ul class="area-features">
						<li>Hollidaysburg, Duncansville, Tyrone, Bellwood</li>
						<li>Pickup available by route schedule</li>
						<li>Waitlist and custom quote options</li>
					</ul>
					<p class="area-hub"><strong>Growing Coverage</strong></p>
				</div>
			</div>
		</div>
	</section>

	<!-- Availability Check -->
	<section class="availability-check" id="zipcode">
		<div class="container">
			<div class="check-content">
				<div class="check-text">
					<h2>Check Your Availability</h2>
					<p>{availabilityMessage}</p>
				</div>
				<div class="check-form">
					<form id="zip-check-form" class="zip-check-form">
						<label for="zipcode">ZIP Code</label>
						<input type="text" id="zipcode" name="zipcode" inputmode="numeric" autocomplete="postal-code" placeholder="Enter your ZIP code" maxlength="5" required />
						<button type="submit" class="btn btn-primary">Check My ZIP Code</button>
					</form>
					<div id="zip-result" class="zip-result" role="status" aria-live="polite">
						<p class="zip-result-placeholder">We’ll confirm whether your ZIP code has daily, weekly, or route-based service.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<script type="module">
		import { getZipAvailability } from '../lib/zipAvailability.js';

		const form = document.getElementById('zip-check-form');
		const input = document.getElementById('zipcode');
		const result = document.getElementById('zip-result');

		if (form && input && result) {
			form.addEventListener('submit', (event) => {
				event.preventDefault();
				const zip = input.value.trim();
				const availability = getZipAvailability(zip);
				result.innerHTML = `
					<p class="zip-result-title">${availability.label}</p>
					<p class="zip-result-summary">${availability.summary}</p>
				`;
			});
		}
	</script>

	<!-- Route Schedule -->
	<section class="route-schedule">
		<div class="container">
			<h2>Route Schedule</h2>
			<div class="schedule-grid">
				<div class="schedule-item">
					<h3>Daily Routes</h3>
					<div class="routes-list">
						<p><strong>Altoona (16601 & nearby)</strong></p>
						<p>Daily service</p>
					</div>
					<div class="routes-list">
						<p><strong>State College (16801 & nearby)</strong></p>
						<p>Daily service</p>
					</div>
				</div>
				<div class="schedule-item">
					<h3>Weekly Routes</h3>
					<div class="routes-list">
						<p><strong>Lock Haven (17745 & nearby)</strong></p>
						<p>Weekly route service</p>
					</div>
				</div>
				<div class="schedule-item">
					<h3>Route-Based Areas</h3>
					<div class="routes-list">
						<p><strong>Blair County, Hollidaysburg, Duncansville, Tyrone, Bellwood</strong></p>
						<p>Pickup and delivery available by route schedule. Enter your ZIP code or request pickup to confirm the next available route day.</p>
					</div>
				</div>
			</div>
			<p class="schedule-note">Expansion areas are added based on demand. Join the waitlist if your town is not on an active route.</p>
		</div>
	</section>

	<!-- Service Details -->
	<section class="service-details">
		<div class="container">
			<h2>How Delivery Pricing Works</h2>
			<div class="details-grid">
				<div class="detail-item">
					<div class="detail-icon">📍</div>
					<h3>Laundry and delivery are priced separately</h3>
					<p>Laundry is by the pound. Delivery uses dispatch fee, mileage, and route conditions.</p>
				</div>
				<div class="detail-item">
					<div class="detail-icon">💰</div>
					<h3>Round-trip mileage pricing</h3>
					<p>Round-trip miles = one-way miles x 2, then multiplied by the applicable mileage rate.</p>
				</div>
				<div class="detail-item">
					<div class="detail-icon">📊</div>
					<h3>Delivery Pass available</h3>
					<p>Delivery Pass removes the base dispatch fee and adds member mileage pricing.</p>
				</div>
			</div>
			<div class="pricing-link">
				<a href="/pricing">View Pricing Details →</a>
			</div>
		</div>
	</section>

	<!-- Waitlist -->
	<section class="waitlist">
		<div class="container">
			<h2>Outside Our Active Service Areas?</h2>
			<p>Join the waitlist and be the first to know when we expand to your area. We're adding new routes based on demand.</p>
			<form class="waitlist-form">
				<div class="form-row">
					<div class="form-group">
						<input type="text" placeholder="First Name" />
					</div>
					<div class="form-group">
						<input type="email" placeholder="Email Address" />
					</div>
					<div class="form-group">
						<input type="text" placeholder="ZIP Code" />
					</div>
				</div>
				<button type="submit" class="btn btn-primary">Join Waitlist</button>
			</form>
			<p class="form-note">We respect your privacy. Your info is safe with us.</p>
		</div>
	</section>

	<!-- Values -->
	<section class="values">
		<div class="container">
			<div class="values-grid">
				<div class="value-item">
					<div class="value-icon">🏘️</div>
					<h3>Local & Trusted</h3>
					<p>Central PA Owned</p>
				</div>
				<div class="value-item">
					<div class="value-icon">⏰</div>
					<h3>Reliable & On-Time</h3>
					<p>Count on our routes</p>
				</div>
				<div class="value-item">
					<div class="value-icon">🛡️</div>
					<h3>Care in Every Load</h3>
					<p>Treated like our own</p>
				</div>
				<div class="value-item">
					<div class="value-icon">🌍</div>
					<h3>Eco-Friendly</h3>
					<p>Better for you & the planet</p>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="final-cta">
		<div class="container">
			<h2>Ready to experience Fresh Fold Laundry Service?</h2>
			<p>Choose your plan and enjoy clean, folded laundry in your area.</p>
			<div class="cta-buttons">
				<a href="/book-pickup" class="btn btn-primary">Book Pickup</a>
				<a href="/subscriptions" class="btn btn-secondary">Start a Subscription</a>
				<a href="/pricing" class="btn btn-secondary">View Pricing</a>
				<a href="/delivery-pass" class="btn btn-secondary">Join Delivery Pass</a>
				<a href="/commercial-laundry" class="btn btn-secondary">Commercial Laundry</a>
				<a href="/contact" class="btn btn-secondary">Contact</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.hero {
		background: linear-gradient(135deg, #f0f4f8 0%, #e8f2f8 100%);
		padding: 60px 0;
		text-align: center;
	}

	.hero h1 {
		color: #001f3f;
		margin-bottom: 15px;
	}

	.hero p {
		color: #666;
		font-size: 1.05rem;
		max-width: 700px;
		margin: 0 auto 30px;
		line-height: 1.8;
	}

	.hero-actions {
		display: flex;
		gap: 15px;
		justify-content: center;
		flex-wrap: wrap;
	}

	.zip-coverage { background:#f4fafc; }
	.zip-coverage h2 { color:#001f3f; text-align:center; margin-bottom:8px; }
	.coverage-intro { max-width:860px; margin:0 auto 25px; color:#5b6775; text-align:center; }
	.coverage-grid { display:grid; grid-template-columns:repeat(3, 1fr); gap:16px; }
	.coverage-card { padding:20px; border:1px solid #d6e7ee; border-radius:10px; background:#fff; }
	.coverage-card h3 { margin-bottom:12px; color:#001f3f; font-size:1rem; }.coverage-card.active h3 { color:#008a87; }.coverage-card.weekly h3 { color:#0066a1; }
	.coverage-list { display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:9px 14px; }.coverage-list p { margin:0; font-size:.85rem; }.coverage-list strong,.coverage-list span { display:block; }.coverage-list span { color:#5b6775; font-size:.78rem; }
	.po-box-note { max-width:900px; margin:18px auto 0; padding:12px 15px; border-left:4px solid #e21c2a; background:#fff; color:#4d5c6d; font-size:.88rem; }

	.service-map {
		padding: 40px 0;
		background-color: #f9f9f9;
	}

	.map-container {
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: 30px;
		align-items: center;
	}

	.map-placeholder {
		width: 100%;
		aspect-ratio: 16/9;
		background: white;
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
	}

	.map-container iframe {
		display: block;
		width: 100%;
		height: 560px;
		border: 0;
		border-radius: 8px;
		box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
	}

	.map-placeholder svg {
		width: 100%;
		height: 100%;
	}

	.service-locations {
		display: flex;
		flex-direction: column;
		gap: 15px;
	}

	.location {
		background: white;
		padding: 15px;
		border-radius: 6px;
		border-left: 4px solid #00a0c6;
		color: #333;
	}

	.service-areas {
		padding: 60px 0;
	}

	.areas-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 25px;
	}

	.area-card {
		background: white;
		padding: 30px;
		border-radius: 8px;
		border: 2px solid #e0e0e0;
		text-align: center;
		transition: all 0.3s;
	}

	.area-card:hover {
		border-color: #00a0c6;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
	}

	.area-icon {
		font-size: 2.5rem;
		margin-bottom: 15px;
	}

	.area-card h3 {
		color: #001f3f;
		margin-bottom: 10px;
	}

	.area-service {
		color: #00a0c6;
		font-weight: 700;
		margin-bottom: 15px;
	}

	.area-features {
		list-style: none;
		margin-bottom: 15px;
		text-align: left;
	}

	.area-features li {
		color: #666;
		margin-bottom: 8px;
		font-size: 0.9rem;
	}

