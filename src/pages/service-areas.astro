		color: #999;
		font-size: 0.9rem;
	}

	.availability-check {
		background-color: white;
		padding: 60px 0;
	}

	.check-content {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 50px;
		align-items: center;
	}

	.check-text h2 {
		color: #001f3f;
		margin-bottom: 15px;
	}

	.check-text p {
		color: #666;
		line-height: 1.8;
	}

	.check-form {
		background: #f9f9f9;
		padding: 30px;
		border-radius: 8px;
	}

	.check-form form {
		display: flex;
		flex-direction: column;
		gap: 15px;
	}

	.check-form label {
		color: #333;
		font-weight: 600;
	}

	.check-form input {
		padding: 12px 15px;
		border: 1px solid #e0e0e0;
		border-radius: 6px;
		font-size: 1rem;
	}

	.check-form button {
		width: 100%;
	}

	.zip-result {
		margin-top: 16px;
		padding: 16px;
		border-radius: 8px;
		background: #ffffff;
		border: 1px solid #dce7ef;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
	}

	.zip-result-title {
		font-weight: 700;
		color: #001f3f;
		margin-bottom: 6px;
	}

	.zip-result-summary {
		color: #4a5568;
		line-height: 1.6;
		margin: 0;
	}

	.zip-result-error {
		color: #b42318;
		font-weight: 600;
		margin: 0;
	}

	.route-schedule {
		background-color: #f0f4f8;
		padding: 60px 0;
	}

	.route-schedule h2 {
		text-align: center;
		color: #001f3f;
		margin-bottom: 40px;
	}

	.schedule-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 30px;
		margin-bottom: 20px;
	}

	.schedule-item {
		background: white;
		padding: 25px;
		border-radius: 8px;
	}

	.schedule-item h3 {
		color: #001f3f;
		margin-bottom: 20px;
	}

	.routes-list {
		margin-bottom: 15px;
		padding-bottom: 15px;
		border-bottom: 1px solid #e0e0e0;
	}

	.routes-list:last-child {
		border-bottom: none;
		margin-bottom: 0;
	}

	.routes-list p {
		color: #666;
		margin-bottom: 5px;
		font-size: 0.9rem;
	}

	.routes-list p strong {
		color: #001f3f;
	}

	.schedule-note {
		text-align: center;
		color: #999;
		font-size: 0.9rem;
	}

	.service-details {
		padding: 60px 0;
	}

	.service-details h2 {
		text-align: center;
		color: #001f3f;
		margin-bottom: 40px;
	}

	.details-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 30px;
		margin-bottom: 30px;
	}

	.detail-item {
		text-align: center;
	}

	.detail-icon {
		font-size: 2.5rem;
		margin-bottom: 15px;
		display: block;
	}

	.detail-item h3 {
		color: #001f3f;
		margin-bottom: 8px;
		font-size: 1.05rem;
	}

	.detail-item p {
		color: #666;
	}

	.pricing-link {
		text-align: center;
	}

	.pricing-link a {
		color: #00a0c6;
		text-decoration: none;
		font-weight: 600;
		transition: color 0.3s;
	}

	.pricing-link a:hover {
		color: #0066a1;
	}

	.waitlist {
		background-color: #f9f9f9;
		padding: 60px 0;
		text-align: center;
	}

	.waitlist h2 {
		color: #001f3f;
		margin-bottom: 15px;
	}

	.waitlist > .container > p {
		color: #666;
		margin-bottom: 30px;
		font-size: 1.05rem;
	}

	.waitlist-form {
		max-width: 700px;
		margin: 0 auto 20px;
	}

	.form-row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 15px;
		margin-bottom: 15px;
	}

	.form-group input {
		width: 100%;
		padding: 12px 15px;
		border: 1px solid #e0e0e0;
		border-radius: 6px;
		font-size: 1rem;
	}

	.waitlist-form button {
		width: 100%;
		max-width: 300px;
	}

	.form-note {
		color: #999;
		font-size: 0.85rem;
	}

	.values {
		padding: 60px 0;
	}

	.values-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 30px;
	}

	.value-item {
		text-align: center;
	}

	.value-icon {
		font-size: 2.5rem;
		margin-bottom: 15px;
		display: block;
	}

	.value-item h3 {
		color: #001f3f;
		margin-bottom: 8px;
	}

	.value-item p {
		color: #666;
	}

	.final-cta {
		background: linear-gradient(135deg, #0066a1 0%, #00a0c6 100%);
		color: white;
		text-align: center;
		padding: 80px 0;
	}

	.final-cta h2 {
		color: white;
		margin-bottom: 10px;
	}

	.final-cta p {
		font-size: 1.1rem;
		margin-bottom: 30px;
		opacity: 0.95;
	}

	.cta-buttons {
		display: flex;
		gap: 15px;
		justify-content: center;
		flex-wrap: wrap;
	}

	.cta-buttons .btn {
		min-width: 180px;
	}

	@media (max-width: 768px) {
		.map-container iframe {
			height: 460px;
		}

		.hero h1 {
			font-size: 1.8rem;
		}

		.check-content {
			grid-template-columns: 1fr;
		}

		.map-container {
			grid-template-columns: 1fr;
		}

		.areas-grid {
			grid-template-columns: 1fr;
		}

		.coverage-grid { grid-template-columns:1fr; }

		.form-row {
			grid-template-columns: 1fr;
		}

		.cta-buttons {
			flex-direction: column;
		}

		.cta-buttons .btn {
			min-width: auto;
		}
	}
</style>
