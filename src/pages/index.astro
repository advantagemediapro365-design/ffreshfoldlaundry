---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Laundry Pickup & Delivery in Central PA | Fresh Fold Laundry Delivery Altoona"
	description="Fresh Fold Laundry Delivery Altoona offers laundry pickup and delivery from Altoona to Lock Haven with wash, dry, fold, subscriptions, add-ons, and commercial service."
	canonicalPath="/"
>
	<!-- Hero Section -->
	<section class="hero">
		<div class="container">
			<div class="hero-content">
				<div class="hero-text">
					<h1>Laundry Pickup & Delivery Made Easy</h1>
					<p>Fresh Fold Delivery makes laundry effortless. We pick up, wash, fold and deliver with care for busy households, students, seniors, businesses, and Airbnb hosts across Central PA.</p>
					<div class="hero-buttons">
						<a href="/book-pickup" class="btn btn-primary">Book Pickup</a>
						<a href="/service-areas" class="btn btn-secondary">Check My ZIP Code</a>
					</div>
				</div>
				<div class="hero-image">
					<div class="placeholder-image">
						<!-- Hero image would go here -->
						
						<img src="/images/freshfold-home-hero.png" alt="FreshFold Laundry & Delivery Logo"  />
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Service Type Icons -->
	<section class="service-types">
		<div class="container">
			<div class="types-grid">
				<div class="type-card">
					<span class="icon" aria-hidden="true">🏠</span>
					<h3>Residential</h3>
				</div>
				<div class="type-card">
					<span class="icon" aria-hidden="true">🎓</span>
					<h3>Student</h3>
				</div>
				<div class="type-card">
					<span class="icon" aria-hidden="true">🏢</span>
					<h3>Commercial</h3>
				</div>
				<div class="type-card">
					<span class="icon" aria-hidden="true">🏠</span>
					<h3>Airbnb</h3>
				</div>
				<div class="type-card">
					<span class="icon" aria-hidden="true">💇</span>
					<h3>Salon & Spa</h3>
				</div>
				<div class="type-card">
					<span class="icon" aria-hidden="true">🍽️</span>
					<h3>Restaurant</h3>
				</div>
				<div class="type-card">
					<span class="icon" aria-hidden="true">💪</span>
					<h3>Gym</h3>
				</div>
				<div class="type-card">
					<span class="icon" aria-hidden="true">🛏️</span>
					<h3>8-15-1,000+ lb</h3>
				</div>
			</div>
		</div>
	</section>

	<!-- How It Works -->
	<section class="how-it-works">
		<div class="container">
			<h2>How It Works</h2>
			<div class="steps-grid">
				<div class="step">
					<div class="step-number">1</div>
					<h3>Schedule Pickup</h3>
					<p>Book online in seconds, choose a time that works best for you.</p>
				</div>
				<div class="step">
					<div class="step-number">2</div>
					<h3>Leave Laundry Out</h3>
					<p>Place your laundry in any bag or basket. We'll pick it up right on time.</p>
				</div>
				<div class="step">
					<div class="step-number">3</div>
					<h3>We Wash & Fold</h3>
					<p>We sort, wash with care, and neatly fold every item.</p>
				</div>
				<div class="step">
					<div class="step-number">4</div>
					<h3>We Deliver It Back</h3>
					<p>Fresh, clean, and folded—delivered to your door on your schedule.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Pricing Preview -->
	<section class="pricing-preview">
		<div class="container">
			<h2>Simple, Transparent Pricing</h2>
			<p class="subtitle">Pay only for the laundry. Delivery is calculated separately.</p>
			<div class="pricing-grid">
				<div class="pricing-card">
					<h3>Standard</h3>
					<div class="price">$1.89<span>/lb</span></div>
					<p>One-time laundry service<br>Great for regular laundry.</p>
				</div>
				<div class="pricing-card">
					<h3>Next-Day</h3>
					<div class="price">$2.49<span>/lb</span></div>
					<p>Next business day<br>Perfect when you need it soon.</p>
				</div>
				<div class="pricing-card featured">
					<div class="badge">Most Popular</div>
					<h3>Same-Day Express</h3>
					<div class="price">$2.79<span>/lb</span></div>
					<p>Same-day delivery<br>Fastest option for on-the-go.</p>
				</div>
				<div class="pricing-card">
					<h3>Bulk & Specialty</h3>
					<div class="price">Quote<span></span></div>
					<p>Comforters, rugs, and large orders<br>Priced after review.</p>
				</div>
			</div>
			<div class="cta-section">
				<a href="/pricing" class="btn btn-primary">View All Pricing</a>
			</div>
		</div>
	</section>

	<!-- Subscriptions -->
	<section class="subscriptions">
		<div class="container">
			<h2>Save More with Subscriptions</h2>
			<p class="subtitle">Flexible plans. Consistent savings. Skip or pause anytime.</p>
			<div class="subscription-grid">
				<div class="subscription-card">
					<h3>Student Plan</h3>
					<div class="price">$109<span>/month</span></div>
					<p>Includes 60 lb/month</p>
					<p>Overage: $1.89/lb</p>
					<p class="small">Students, light weekly laundry, and parent-paid student plans</p>
					<a href="/subscriptions/student-plan" class="btn btn-primary">View Plan</a>
				</div>
				<div class="subscription-card">
					<h3>Weekly Household Plan</h3>
					<div class="price">$149<span>/month</span></div>
					<p>Includes 85 lb/month</p>
					<p>Overage: $1.75/lb</p>
					<p class="small">Couples, small households</p>
					<a href="/subscriptions/weekly-household-plan" class="btn btn-primary">View Plan</a>
				</div>
				<div class="subscription-card">
					<h3>Family Plan</h3>
					<div class="price">$229<span>/month</span></div>
					<p>Includes 150 lb/month</p>
					<p>Overage: $1.65/lb</p>
					<p class="small">Families with larger laundry needs</p>
					<a href="/subscriptions/family-plan" class="btn btn-primary">View Plan</a>
				</div>
				<div class="subscription-card featured">
					<div class="badge">Best Value</div>
					<h3>Route Plus Plan</h3>
					<div class="price">$299<span>/month</span></div>
					<p>Includes 200 lb/month</p>
					<p>Overage: $1.50/lb</p>
					<p class="small">High-volume homes, shared houses, and recurring heavy users</p>
					<a href="/subscriptions/route-plus-plan" class="btn btn-primary">View Plan</a>
				</div>
			</div>
			<p class="subscription-note">Subscriptions cover laundry processing only. Delivery is calculated separately unless Delivery Pass or an approved promotion applies.</p>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="cta-banner">
		<div class="container">
			<h2>Ready to make laundry one less thing to think about?</h2>
			<p>Choose your plan and enjoy, folded laundry—week after week.</p>
			<div class="cta-buttons">
				<a href="/book-pickup" class="btn btn-primary">Book Pickup</a>
				<a href="/subscriptions" class="btn btn-secondary">Start a Subscription</a>
			</div>
		</div>
	</section>

	<!-- Blog Preview -->
	<section class="blog-preview">
		<div class="container">
			<h2>From Our Blog</h2>
			<div class="blog-grid">
				<article class="blog-card">
					<div class="blog-image"></div>
					<h3>5 Laundry Tips to Save Time and Money</h3>
					<p>Email storage experts about routine tips that can make a difference. Here are our top tips from the laundry press.</p>
					<a href="/blog" class="read-more">Read More →</a>
				</article>
				<article class="blog-card">
					<div class="blog-image"></div>
					<h3>College Laundry Hacks Every Student Needs</h3>
					<p>Stay on top of laundry without spending time doing laundry. Introducing classes and campus laundry hacks.</p>
					<a href="/blog" class="read-more">Read More →</a>
				</article>
				<article class="blog-card">
					<div class="blog-image"></div>
					<h3>Why Local Laundry Service Matters</h3>
					<p>Supporting local businesses helps our communities. Happier homes and happier lives within our communities.</p>
					<a href="/blog" class="read-more">Read More →</a>
				</article>
			</div>
			<div class="view-all">
				<a href="/blog" class="btn btn-primary">View All Articles</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.hero {
		background: linear-gradient(135deg, #f0f4f8 0%, #e8f2f8 100%);
		padding: 80px 0;
	}

	.hero-content {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 60px;
		align-items: center;
	}

	.hero-text h1 {
		margin-bottom: 20px;
		color: #001f3f;
	}

	.hero-text p {
		font-size: 1.1rem;
		color: #555;
		margin-bottom: 30px;
		line-height: 1.8;
	}

	.hero-buttons {
		display: flex;
		gap: 15px;
		flex-wrap: wrap;
	}

	.placeholder-image {
		background: white;
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
		aspect-ratio: 1;
	}

	.placeholder-image img {
		width: 100%;
		height: 100%;
		
		
	}

	.service-types {
		background-color: #f9f9f9;
	}

	.types-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: 20px;
	}

	.type-card {
		background: white;
		padding: 30px 20px;
		border-radius: 8px;
		text-align: center;
		border: 1px solid #e0e0e0;
		transition: all 0.3s;
	}

	.type-card:hover {
		box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
		transform: translateY(-5px);
	}

	.type-card .icon {
		font-size: 2.5rem;
		display: block;
		margin-bottom: 10px;
	}

	.type-card h3 {
		font-size: 1rem;
		color: #333;
	}

	.how-it-works {
		background-color: white;
	}

	.how-it-works h2 {
		text-align: center;
		margin-bottom: 50px;
		color: #001f3f;
	}

	.steps-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 40px;
	}

	.step {
		text-align: center;
	}

	.step-number {
		display: inline-block;
		width: 60px;
		height: 60px;
		background-color: #00a0c6;
		color: white;
		border-radius: 50%;
		font-size: 1.5rem;
		font-weight: 700;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 15px;
	}

	.step h3 {
		margin-bottom: 10px;
		color: #001f3f;
	}

	.step p {
		color: #666;
		line-height: 1.6;
	}

	.pricing-preview {
		background: linear-gradient(135deg, #f0f4f8 0%, #e8f2f8 100%);
	}

	.pricing-preview h2 {
		text-align: center;
		color: #001f3f;
		margin-bottom: 10px;
	}

	.subtitle {
		text-align: center;
		color: #666;
		margin-bottom: 40px;
		font-size: 1.1rem;
	}

	.pricing-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 30px;
		margin-bottom: 30px;
	}

	.pricing-card {
		background: white;
		padding: 30px;
		border-radius: 8px;
		border: 2px solid transparent;
		text-align: center;
		position: relative;
		transition: all 0.3s;
	}

	.pricing-card:hover {
		transform: translateY(-10px);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
	}

	.pricing-card.featured {
		border-color: #00a0c6;
		transform: scale(1.05);
		box-shadow: 0 10px 30px rgba(0, 160, 198, 0.2);
	}

	.pricing-card h3 {
		margin-bottom: 15px;
		color: #001f3f;
	}

	.price {
		font-size: 2rem;
		font-weight: 700;
		color: #00a0c6;
		margin-bottom: 10px;
	}

	.price span {
		font-size: 1rem;
		color: #666;
		font-weight: 500;
	}

	.pricing-card p {
		color: #666;
		margin-bottom: 20px;
		font-size: 0.9rem;
	}

	.badge {
		position: absolute;
		top: 15px;
		left: 50%;
		transform: translateX(-50%);
		background-color: #00a0c6;
		color: white;
		padding: 8px 16px;
		border-radius: 20px;
		font-size: 0.8rem;
		font-weight: 600;
	}

	.cta-section {
		text-align: center;
	}

	.subscriptions {
		background-color: white;
	}

	.subscriptions h2 {
		text-align: center;
		color: #001f3f;
		margin-bottom: 10px;
	}

	.subscription-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 30px;
		margin-top: 40px;
	}

	.subscription-card {
		background: white;
		padding: 30px;
		border-radius: 8px;
		border: 2px solid #e0e0e0;
		text-align: center;
		position: relative;
		transition: all 0.3s;
	}

	.subscription-card:hover {
		border-color: #00a0c6;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
	}

	.subscription-card.featured {
		border-color: #00a0c6;
		background: linear-gradient(135deg, #f0f4f8 0%, #e8f2f8 100%);
	}

	.subscription-card h3 {
		color: #001f3f;
		margin-bottom: 10px;
	}

	.subscription-card .price {
		margin-bottom: 15px;
	}

	.subscription-card p {
		color: #666;
		font-size: 0.95rem;
		margin-bottom: 8px;
	}

	.subscription-card .small {
		font-size: 0.85rem;
		opacity: 0.8;
		margin: 10px 0 20px 0;
	}

	.subscription-card button,
	.subscription-card .btn {
		width: 100%;
		text-align: center;
	}

	.subscription-note {
		color: #666;
		text-align: center;
		max-width: 820px;
		margin: 24px auto 0;
		line-height: 1.7;
	}

	.cta-banner {
		background: linear-gradient(135deg, #0066a1 0%, #00a0c6 100%);
		color: white;
		text-align: center;
		padding: 80px 0;
	}

	.cta-banner h2 {
		color: white;
		margin-bottom: 15px;
	}

	.cta-banner p {
		font-size: 1.1rem;
		margin-bottom: 30px;
		opacity: 0.95;
	}

	.cta-buttons {
		display: flex;
		gap: 15px;
		justify-content: center;
		flex-wrap: wrap;
	}

	.cta-buttons .btn {
		min-width: 200px;
	}

	.blog-preview {
		background-color: #f9f9f9;
	}

	.blog-preview h2 {
		text-align: center;
		color: #001f3f;
		margin-bottom: 40px;
	}

	.blog-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 30px;
		margin-bottom: 40px;
	}

	.blog-card {
		background: white;
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
		transition: all 0.3s;
	}

	.blog-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
	}

	.blog-image {
		width: 100%;
		height: 200px;
		background: linear-gradient(135deg, #e8f2f8 0%, #d4e6f1 100%);
	}

	.blog-card h3 {
		padding: 20px 20px 10px;
		color: #001f3f;
		font-size: 1.2rem;
	}

	.blog-card p {
		padding: 0 20px 15px;
		color: #666;
		font-size: 0.95rem;
	}

	.read-more {
		display: inline-block;
		padding: 0 20px 20px;
		color: #00a0c6;
		text-decoration: none;
		font-weight: 600;
		transition: color 0.3s;
	}

	.read-more:hover {
		color: #0066a1;
	}

	.view-all {
		text-align: center;
	}

	@media (max-width: 768px) {
		.hero-content {
			grid-template-columns: 1fr;
			gap: 30px;
		}

		.hero {
			padding: 40px 0;
		}

		.hero-text h1 {
			font-size: 1.8rem;
		}

		.types-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.pricing-card.featured {
			transform: scale(1);
		}

		.steps-grid {
			gap: 20px;
		}

		.cta-buttons {
			flex-direction: column;
		}

		.cta-buttons .btn {
			min-width: auto;
		}

		.subscription-grid {
			grid-template-columns: 1fr;
		}

		.cta-banner {
			padding: 40px 0;
		}

		.cta-banner h2 {
			font-size: 1.8rem;
		}
	}
</style>
