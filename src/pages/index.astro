---
import Layout from "../layouts/Layout.astro";
import { SERVICE_AREA_GROUPS } from "../lib/zipAvailability.js";
const services = [
  ["Residential", "Everyday laundry", "residential.png"],
  ["Student Laundry", "Dorm & apartment", "student_laundry.png"],
  ["Commercial", "Businesses of all sizes", "commercial.png"],
  ["Airbnb / STR", "Short-term rentals", "airbnb.png"],
  ["Salon & Spa", "Towels & linens", "salonspa.png"],
  ["Restaurant", "Table linens & towels", "restaurant.png"],
  ["Gym & Fitness", "Towels & gear", "gynfitness.png"],
];
---

<Layout
  title="Laundry Pickup & Delivery in Altoona & Central PA | Fresh Fold Altoona"
  description="Fresh Fold Altoona provides laundry pickup, wash, dry, fold, and delivery across Central Pennsylvania."
>
  <section class="home-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">LOCAL. RELIABLE. TRUSTED.</p><h1>
          Laundry Picked Up,<br />Washed, Folded &amp;<br /><span
            >Delivered.</span>
        </h1><p class="lead">
          Skip the laundromat. We pick up your laundry, wash, dry, fold and
          deliver it back clean and ready to put away.
        </p><div class="trust">
          <span>◎<b>Convenient<br />Pickup &amp; Delivery</b></span><span
            >♡<b>Professional<br />Care</b></span
          ><span>◷<b>On-Time<br />Every Time</b></span><span
            >⌂<b>Locally<br />Owned</b></span>
        </div><div class="hero-actions">
          <a href="/book-pickup" class="btn btn-primary">▣ Book My Pickup</a><a
            href="sms:+15704947523?body=Fresh%20Fold%20pickup%20request"
            class="btn btn-secondary">☎ Text to Book</a
          ><a href="tel:+15704947523" class="btn btn-secondary"
            >☎ Call 570-494-7523</a>
        </div><p class="tnt">
          ♥ Delivered by TNT Deliveries <i
            >Don&apos;t forget to tip your delivery driver!</i>
        </p>
      </div><div class="hero-img">
        <img
          src="/images/freshfold-home-hero.png"
          alt="Fresh Fold laundry pickup and delivery"
        /><div class="badge">
          GRAND OPENING<br /><b>SEPTEMBER 15</b><strong>$1.25</strong><small
            >PER POUND<br />Wash • Dry • Fold</small>
        </div><form class="zipbox" action="/service-areas#zipcode">
          <h2>⌖ Check Your ZIP &amp; Book Now</h2><div>
            <input
              name="zipcode"
              placeholder="Enter your ZIP code"
              inputmode="numeric"
              maxlength="5"
              required
            /><button type="submit" aria-label="Check ZIP code">→</button>
          </div><p>
            ✓ See if we service your area<br />✓ Choose your pickup date &amp;
            time<br />✓ Select your laundry preferences<br />✓ Confirm and relax
          </p><b>▣ Plans starting at <strong>$50/month</strong> + delivery</b
          ><div class="zipbox-result" role="status" aria-live="polite"></div>
        </form>
      </div>
    </div>
  </section>
  <section class="service-strip">
    <div class="container service-grid">
      {
        services.map(([name, detail, img]) => (
          <a
            href={
              name === "Commercial" ? "/commercial-laundry" : "/book-pickup"
            }
          >
            <>
              <img src={`/images/${img}`} alt={`${name} laundry`} />
              <b>{name}</b>
              <small>{detail}</small>
            </>
          </a>
        ))
      }
    </div>
  </section>
  <section class="container twin">
    <article>
      <h2>How It Works</h2><div class="how">
        <span><b>1</b>Book<small>Call, text or book online.</small></span><i
          >→</i
        ><span><b>2</b>Pickup<small>We collect your laundry.</small></span><i
          >→</i
        ><span><b>3</b>Wash &amp; Fold<small>We clean with care.</small></span
        ><i>→</i><span
          ><b>4</b>Deliver<small>Clean laundry returns to you.</small></span>
      </div>
    </article><article class="why">
      <h2>Why Choose Fresh Fold?</h2><p>
        ✓ Local &amp; Reliable<br />✓ On-Time, Every Time<br />✓ Care in Every
        Load<br />✓ Easy Online Booking<br />✓ Supporting Local Communities
      </p><img
        src="/images/dog_wash_freshfold.png"
        alt="Fresh Fold cares for every load"
      />
    </article>
  </section>
  <section class="container offers">
    <article class="price-box">
      <h2>Simple, Transparent Pricing</h2><p>
        No hidden fees. See exactly what you&apos;ll pay.
      </p><div>
        <section>
          <h3>Laundry Processing</h3><b>$1.89 <small>/ lb</small></b><p>
            Wash • Dry • Fold
          </p>
        </section><section>
          <h3>Delivery (TNT Deliveries)</h3><strong
            >$3.80 base dispatch fee</strong
          ><p>+ $1.75 per round-trip mile</p>
        </section><section>
          <h3>Subscriptions Start at</h3><b>$79 <small>/ month</small></b><p>
            40 lb/month • 2 pickups
          </p><a href="/subscriptions">View All Plans</a>
        </section>
      </div>
    </article><div>
      <article class="referral">
        <h2>Know Someone Nearby Who Needs Laundry Done Too?</h2><p>
          Book together and ask about shared-route savings.
        </p>
      </article><article class="warning">
        <h2>△ Empty All Pockets Before Pickup</h2><p>
          No flammable, hazardous, illegal, sharp or unsafe items. Significant
          messes or safety hazards may result in a $25 charge.
        </p>
      </article>
    </div>
  </section>
  <section class="container area">
    <article>
      <h2>Our Service Areas</h2><p>
        Altoona • State College • Lock Haven • Blair County &amp; surrounding
        areas
      </p><div class="area-layout">
        <img
          src="/images/servicearea.png"
          alt="Central Pennsylvania service-area map"
        /><div>
          {
            SERVICE_AREA_GROUPS.map((g) => (
              <section>
                <h3>{g.region}</h3>
                {g.areas.map(([town, zips]) => (
                  <p>
                    <b>{town}</b> {zips}
                  </p>
                ))}
              </section>
            ))
          }<a href="/service-areas#zipcode" class="btn btn-primary"
            >View Full Service Area Map →</a>
        </div>
      </div>
    </article><aside>
      <h2>Quick Links</h2><a href="/pricing">Pricing &amp; Delivery</a><a
        href="/service-areas">Service Areas</a
      ><a href="/blog">Laundry Tips</a><a href="/faq">Common Questions</a><a
        href="/book-pickup">Book Your Pickup</a
      ><a href="/contact">Contact Us</a>
    </aside>
  </section>
  <section class="community">
    <div class="container">
      <b
        >♥ Proudly Serving Central Pennsylvania<br /><span
          >Cleaner Clothes. Stronger Communities.</span
        ></b
      ><strong>▣ Delivered by TNT Deliveries</strong>
    </div>
  </section>
</Layout>
<script>
  const zipForm = document.querySelector<HTMLFormElement>(".zipbox");
  const zipInput = zipForm?.querySelector<HTMLInputElement>(
    'input[name="zipcode"]',
  );
  const zipResult = zipForm?.querySelector<HTMLElement>(".zipbox-result");

  zipForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!zipInput || !zipResult) return;
    const zip = zipInput.value.trim();
    const response = await fetch(
      `/api/service-area?zip=${encodeURIComponent(zip)}`,
    ).catch(() => null);
    const availability = response?.ok ? await response.json() : null;
    if (availability) {
      zipResult.textContent = `${availability.label}: ${availability.summary}`;
      return;
    }
    zipResult.textContent =
      "Please check your ZIP code on our Service Areas page.";
    window.location.href = `/service-areas#zipcode`;
  });
</script>
<style>
  .home-hero {
    padding: 28px 0 18px;
    background:
      linear-gradient(
        90deg,
        #fff 0%,
        rgba(255, 255, 255, 0.75) 47%,
        transparent 75%
      ),
      #eaf6ff;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    gap: 20px;
    align-items: center;
  }
  .eyebrow {
    color: var(--primary);
    font-weight: 800;
    font-size: 0.83rem;
  }
  .home-hero h1 {
    margin: 5px 0;
    color: var(--primary);
    font-size: clamp(2.5rem, 4.9vw, 4.3rem);
    letter-spacing: -0.045em;
  }
  .home-hero h1 span {
    color: #009dc4;
  }
  .lead {
    max-width: 600px;
    color: var(--primary);
    font-weight: 600;
  }
  .trust {
    display: flex;
    gap: 22px;
    margin: 17px 0;
  }
  .trust span {
    display: grid;
    justify-items: center;
    color: #009dc4;
    font-size: 1.5rem;
  }
  .trust b {
    color: var(--primary);
    font-size: 0.66rem;
    text-align: center;
    line-height: 1.2;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tnt {
    color: var(--primary);
    font-size: 0.78rem;
    font-weight: 800;
  }
  .tnt i {
    margin-left: 12px;
    font-style: normal;
  }
  .hero-img {
    position: relative;
    min-height: 365px;
  }
  .hero-img > img {
    width: 100%;
    height: 365px;
    object-fit: cover;
    border-radius: 14px;
  }
  .badge {
    position: absolute;
    top: 20px;
    left: -25px;
    display: grid;
    justify-items: center;
    width: 158px;
    padding: 15px;
    background: #009dc4;
    border: 5px solid #fff;
    border-radius: 25px;
    color: #fff;
    transform: rotate(-11deg);
    font-size: 0.78rem;
    font-weight: 800;
    text-align: center;
  }
  .badge strong {
    font-size: 2.7rem;
    line-height: 1;
  }
  .badge small {
    font-size: 0.68rem;
  }
  .zipbox {
    position: absolute;
    top: 18px;
    right: -8px;
    width: 270px;
    padding: 17px;
    background: #fff;
    border-radius: 13px;
    box-shadow: 0 9px 24px rgba(15, 39, 66, 0.2);
  }
  .zipbox h2 {
    font-size: 1rem;
    color: var(--primary);
  }
  .zipbox div {
    display: flex;
    margin: 10px 0;
  }
  .zipbox input {
    min-width: 0;
    width: 100%;
    padding: 9px;
    border: 1px solid var(--border);
    border-radius: 5px 0 0 5px;
  }
  .zipbox button {
    width: 40px;
    border: 0;
    border-radius: 0 5px 5px 0;
    background: #009dc4;
    color: #fff;
    font-size: 1.2rem;
  }
  .zipbox p {
    color: var(--primary);
    font-size: 0.72rem;
    line-height: 1.8;
  }
  .zipbox > b {
    display: block;
    padding-top: 10px;
    border-top: 1px solid var(--border);
    font-size: 0.72rem;
    color: var(--primary);
  }
  .zipbox > b strong {
    font-size: 1.1rem;
  }
  .service-strip {
    padding: 10px 0;
  }
  .service-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 7px;
  }
  .service-grid a {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--primary);
    text-align: center;
    text-decoration: none;
  }
  .service-grid img {
    width: 100%;
    height: 68px;
    object-fit: cover;
    display: block;
  }
  .service-grid b,
  .service-grid small {
    display: block;
    font-size: 0.68rem;
    line-height: 1.2;
    padding: 3px;
  }
  .service-grid small {
    padding-bottom: 7px;
    color: var(--muted);
    font-size: 0.59rem;
  }
  .twin,
  .offers,
  .area {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding-top: 10px;
  }
  .twin article,
  .price-box,
  .referral,
  .warning,
  .area article,
  .area aside {
    padding: 14px;
    border: 1px solid #cfe5ee;
    border-radius: 8px;
  }
  .twin h2,
  .offers h2,
  .area h2 {
    margin: 0;
    color: var(--primary);
    font-size: 1.22rem;
  }
  .how {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    align-items: center;
    margin-top: 14px;
    text-align: center;
  }
  .how span {
    display: grid;
    justify-items: center;
    color: var(--primary);
    font-size: 0.72rem;
    font-weight: 800;
  }
  .how span b {
    display: grid;
    place-items: center;
    width: 31px;
    height: 31px;
    border-radius: 50%;
    background: #009dc4;
    color: #fff;
  }
  .how small {
    font-size: 0.59rem;
    font-weight: 500;
  }
  .how i {
    color: #009dc4;
    font-style: normal;
  }
  .why {
    position: relative;
  }
  .why p {
    color: var(--primary);
    font-size: 0.78rem;
    line-height: 1.8;
  }
  .why img {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 36%;
    max-height: 120px;
    object-fit: cover;
  }
  .offers {
    grid-template-columns: 1.65fr 0.95fr;
  }
  .price-box > p,
  .area > article > p {
    margin: 3px 0 10px;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .price-box > div {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
  .price-box section {
    padding: 11px;
    border: 1px solid #e0edf2;
    border-radius: 6px;
  }
  .price-box h3 {
    margin: 0;
    color: var(--primary);
    font-size: 0.78rem;
  }
  .price-box b {
    display: block;
    color: var(--primary);
    font-size: 2rem;
  }
  .price-box b small {
    font-size: 0.75rem;
  }
  .price-box section p {
    margin: 3px 0;
    color: var(--muted);
    font-size: 0.65rem;
  }
  .price-box a {
    display: block;
    padding: 6px;
    border-radius: 4px;
    background: #009dc4;
    color: #fff;
    text-align: center;
    text-decoration: none;
    font-size: 0.65rem;
  }
  .referral {
    margin-bottom: 10px;
  }
  .referral h2,
  .warning h2 {
    font-size: 0.9rem;
  }
  .referral p,
  .warning p {
    font-size: 0.7rem;
    margin: 6px 0;
  }
  .warning {
    background: #ef2935;
    color: #fff;
  }
  .warning h2 {
    color: #fff;
  }
  .area {
    grid-template-columns: 1.65fr 0.95fr;
  }
  .area-layout {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: 9px;
  }
  .area-layout > img {
    width: 100%;
    height: 190px;
    object-fit: cover;
  }
  .area-layout > div {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6px;
  }
  .area-layout section h3 {
    margin: 0;
    color: #009dc4;
    font-size: 0.7rem;
  }
  .area-layout section p {
    margin: 1px 0;
    color: var(--primary);
    font-size: 0.61rem;
  }
  .area-layout .btn {
    grid-column: 1/-1;
    font-size: 0.7rem;
  }
  .area aside {
    display: grid;
    align-content: start;
    gap: 7px;
  }
  .area aside a {
    padding: 5px 0;
    border-bottom: 1px solid var(--border);
    color: var(--primary);
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
  }
  .community {
    padding: 0;
    margin-top: 12px;
    background: linear-gradient(90deg, #b8e3f8, #eaf6ff, #b8e3f8);
  }
  .community .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 76px;
    color: var(--primary);
  }
  .community span {
    font-size: 1.08rem;
  }
  .community strong {
    font-size: 0.85rem;
  }
  @media (max-width: 850px) {
    .hero-grid,
    .offers,
    .area {
      grid-template-columns: 1fr;
    }
    .hero-img {
      max-width: 650px;
      width: 100%;
      margin: auto;
    }
    .service-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (max-width: 600px) {
    .home-hero {
      padding-top: 18px;
    }
    .hero-img {
      min-height: 350px;
    }
    .hero-img > img {
      height: 255px;
    }
    .badge {
      left: -5px;
      width: 130px;
      padding: 10px;
    }
    .badge strong {
      font-size: 2.2rem;
    }
    .zipbox {
      top: 135px;
      right: 50%;
      width: min(92%, 300px);
      transform: translateX(50%);
    }
    .trust {
      justify-content: space-between;
      gap: 3px;
    }
    .trust span {
      font-size: 1.2rem;
    }
    .trust b {
      font-size: 0.56rem;
    }
    .hero-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .hero-actions a:last-child {
      grid-column: 1/-1;
    }
    .service-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .service-grid img {
      height: 78px;
    }
    .twin,
    .offers,
    .area {
      grid-template-columns: 1fr;
    }
    .how {
      grid-template-columns: repeat(4, 1fr);
      gap: 5px;
    }
    .how i {
      display: none;
    }
    .price-box > div,
    .area-layout,
    .area-layout > div {
      grid-template-columns: 1fr;
    }
    .why img {
      display: none;
    }
    .community .container {
      padding: 12px 20px;
    }
    .community strong {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .hero-img {
      min-height: 460px;
    }

    .zipbox {
      top: 205px;
    }
  }

  .zipbox-result {
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px solid var(--border);
    color: var(--primary);
    font-size: 0.72rem;
    line-height: 1.35;
  }
</style>
