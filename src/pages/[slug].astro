---
import Layout from '../layouts/Layout.astro';

function getPages() {
	return [
	{ slug: 'about', type: 'Company', title: 'About Fresh Fold Delivery | Central PA Laundry Service', h1: 'About Fresh Fold Delivery', cta: 'Book Pickup', description: 'Fresh Fold Delivery is a Central PA laundry pickup and delivery service for households, students, seniors, businesses, and local routes.' },
	{ slug: 'faq', type: 'FAQ', title: 'Laundry Pickup & Delivery FAQs | Fresh Fold Delivery', h1: 'Frequently Asked Questions', cta: 'Ask a Question', description: 'Find answers about Fresh Fold Delivery laundry pickup, delivery pricing, subscriptions, service areas, commercial laundry, and route availability.' },
	{ slug: 'student-laundry-service-state-college', type: 'Student Laundry', title: 'Penn State Student Laundry Service | Fresh Fold Delivery', h1: 'Student Laundry Pickup in State College', cta: 'Start Student Plan', description: 'Fresh Fold Delivery offers student laundry pickup in State College with route-based pickup, wash, dry, fold service, and parent-friendly plan options.' },
	{ slug: 'delivery-route-policy', type: 'Policy', title: 'Delivery & Route Policy | Fresh Fold Delivery', h1: 'Delivery & Route Policy', cta: 'Book Pickup', description: 'Review Fresh Fold Delivery route, delivery, mileage, availability, and pickup policies for laundry pickup and delivery service.' },
	{ slug: 'terms-of-service', type: 'Policy', title: 'Terms of Service | Fresh Fold Delivery', h1: 'Terms of Service', cta: 'Book Pickup', description: 'Review Fresh Fold Delivery terms of service for laundry pickup, wash dry fold, delivery, subscriptions, and commercial requests.' },
	{ slug: 'privacy-policy', type: 'Policy', title: 'Privacy Policy | Fresh Fold Delivery', h1: 'Privacy Policy', cta: 'Contact Support', description: 'Review the Fresh Fold Delivery privacy policy for customer information, booking details, communications, and service requests.' },
	{ slug: 'cookie-policy', type: 'Policy', title: 'Cookie Policy | Fresh Fold Delivery', h1: 'Cookie Policy', cta: 'Contact Support', description: 'Review how Fresh Fold Delivery uses necessary cookies, local storage, analytics, and third-party embeds.' },
	{ slug: 'refund-damage-policy', type: 'Policy', title: 'Refund & Damage Policy | Fresh Fold Delivery', h1: 'Refund, Damage & Rewash Policy', cta: 'Contact Support', description: 'Review Fresh Fold Delivery refund, damage, rewash, and issue-resolution policies for laundry pickup and delivery orders.' },
	{ slug: 'subscription-policy', type: 'Policy', title: 'Laundry Subscription Policy | Fresh Fold Delivery', h1: 'Subscription Policy', cta: 'Start Subscription', description: 'Review Fresh Fold Delivery subscription rules, billing expectations, route availability, pauses, and delivery exclusions.' },
	{ slug: 'pocket-heavy-soil-policy', type: 'Policy', title: 'Pocket & Heavy Soil Laundry Policy | Fresh Fold Delivery', h1: 'Pocket, Heavy Soil & Special-Care Policy', cta: 'Book Pickup', description: 'Review Fresh Fold Delivery policies for pockets, heavy soil, pet hair, special-care laundry, and customer preparation responsibilities.' },
	{ slug: 'fresh-fold-bag-policy', type: 'Policy', title: 'Fresh Fold Bag Rental & Deposit Policy', h1: 'Fresh Fold Bag Rental & Deposit Policy', cta: 'Book Pickup', description: 'Review the Fresh Fold bag rental and deposit policy for laundry pickup, bag use, returns, and customer responsibilities.' },
	{ slug: 'wash-dry-fold-service', type: 'Service', title: 'Wash Dry Fold Service in Central PA', h1: 'Wash, Dry & Fold Service', cta: 'Book Pickup', description: 'Fresh Fold Delivery offers wash, dry, and fold laundry service in Central PA with pickup, delivery, subscriptions, and commercial options.' },
	{ slug: 'laundry-pickup-service', type: 'Service', title: 'Laundry Pickup Service in Central PA', h1: 'Laundry Pickup Service', cta: 'Schedule Pickup', description: 'Fresh Fold Delivery offers laundry pickup service in Central PA with wash, dry, fold care and delivery returned through local routes.' },
	{ slug: 'same-day-laundry-service', type: 'Service', title: 'Same-Day Laundry Service in Altoona & State College', h1: 'Same-Day Laundry Pickup & Delivery', cta: 'Check Availability', description: 'Fresh Fold Delivery offers same-day laundry service when available in Altoona, State College, and eligible Central PA routes.' },
	{ slug: 'next-day-laundry-service', type: 'Service', title: 'Next-Day Laundry Pickup & Delivery', h1: 'Next-Day Laundry Service', cta: 'Book Next-Day', description: 'Fresh Fold Delivery offers next-day laundry pickup and delivery service for eligible Central PA customers and routes.' },
	{ slug: 'senior-laundry-service', type: 'Service', title: 'Senior Laundry Pickup & Delivery', h1: 'Laundry Help for Seniors', cta: 'Request Pickup', description: 'Fresh Fold Delivery helps seniors with laundry pickup, wash, dry, fold care, and delivery in eligible Central PA service areas.' },
	{ slug: 'family-laundry-service', type: 'Service', title: 'Family Laundry Pickup & Delivery', h1: 'Family Laundry Service', cta: 'Start Family Plan', description: 'Fresh Fold Delivery offers family laundry pickup and delivery service with subscriptions and recurring wash dry fold support.' },
	{ slug: 'apartment-laundry-service', type: 'Service', title: 'Apartment Laundry Pickup & Delivery', h1: 'Apartment Laundry Service', cta: 'Book Pickup', description: 'Fresh Fold Delivery offers apartment laundry pickup and delivery service for renters, busy professionals, students, and families.' },
	{ slug: 'move-out-laundry-service', type: 'Service', title: 'Move-Out Laundry Service for Students & Rentals', h1: 'Move-Out Laundry Service', cta: 'Get Estimate', description: 'Fresh Fold Delivery offers move-out laundry service for students, rentals, linens, towels, and busy turnover days in eligible areas.' },
	{ slug: 'salon-spa-laundry-service', type: 'Commercial', title: 'Salon & Spa Laundry Service in Central PA', h1: 'Salon & Spa Laundry Service', cta: 'Get Quote', description: 'Fresh Fold Delivery offers salon and spa laundry service in Central PA for towels, robes, capes, sheets, and recurring business laundry.' },
	{ slug: 'gym-laundry-service', type: 'Commercial', title: 'Gym Towel Laundry Service in Central PA', h1: 'Gym Laundry Pickup & Delivery', cta: 'Get Quote', description: 'Fresh Fold Delivery offers gym towel laundry pickup and delivery for fitness studios, gyms, wellness centers, and recurring towel programs.' },
	{ slug: 'restaurant-laundry-service', type: 'Commercial', title: 'Restaurant Towel & Linen Laundry Service', h1: 'Restaurant Laundry Service', cta: 'Get Quote', description: 'Fresh Fold Delivery offers restaurant towel and linen laundry service for Central PA kitchens, dining rooms, and recurring business needs.' },
	{ slug: 'airbnb-rental-laundry-service', type: 'Commercial', title: 'Airbnb & Rental Laundry Service in Central PA', h1: 'Airbnb & Rental Laundry Service', cta: 'Get Quote', description: 'Fresh Fold Delivery offers Airbnb and rental laundry service for sheets, towels, linens, turnovers, and short-term rental hosts.' },
	{ slug: 'hotel-laundry-service', type: 'Commercial', title: 'Small Hotel Laundry Service in Central PA', h1: 'Hotel Laundry Pickup & Delivery', cta: 'Get Quote', description: 'Fresh Fold Delivery offers small hotel laundry pickup and delivery for towels, linens, sheets, and recurring hospitality laundry.' },
	{ slug: 'barbershop-laundry-service', type: 'Commercial', title: 'Barbershop Towel Laundry Service', h1: 'Barbershop Laundry Pickup & Delivery', cta: 'Get Quote', description: 'Fresh Fold Delivery offers barbershop towel laundry service for towels, capes, and recurring shop laundry in eligible Central PA routes.' },
	{ slug: 'massage-therapy-laundry-service', type: 'Commercial', title: 'Massage Therapy Laundry Service', h1: 'Massage Laundry Pickup & Delivery', cta: 'Get Quote', description: 'Fresh Fold Delivery offers massage therapy laundry service for sheets, towels, linens, and recurring wellness business laundry.' },
	{ slug: 'cleaning-company-laundry-service', type: 'Commercial', title: 'Cleaning Company Laundry Service', h1: 'Laundry Service for Cleaning Companies', cta: 'Get Quote', description: 'Fresh Fold Delivery offers laundry service for cleaning companies, including towels, rags, linens, and recurring route-based pickup.' },
	{ slug: 'high-volume-laundry-service', type: 'Commercial', title: 'High-Volume Laundry Pickup & Delivery', h1: 'High-Volume Laundry Service', cta: 'Request Pricing', description: 'Fresh Fold Delivery offers high-volume laundry pickup and delivery quotes for businesses, rentals, facilities, and recurring laundry needs.' },
	{ slug: 'comforter-specialty-laundry', type: 'Service', title: 'Comforter & Specialty Laundry Service', h1: 'Comforter & Specialty Laundry', cta: 'Book Specialty Pickup', description: 'Fresh Fold Delivery offers comforter and specialty laundry service for bulky items, bedding, pillows, blankets, and eligible pickup routes.' },
	];
}

const page = getPages().find((item) => item.slug === Astro.params.slug);
if (!page) {
	return Astro.redirect('/');
}

const isPolicy = page.type === 'Policy';
const isCommercial = page.type === 'Commercial';
const isCookiePolicy = page.slug === 'cookie-policy';
---

<Layout title={page.title} description={page.description} canonicalPath={`/${page.slug}`}>
	<section class="hero">
		<div class="container">
			<p class="eyebrow">{page.type}</p>
			<h1>{page.h1}</h1>
			<p>{page.description}</p>
			<div class="actions">
				<a href={isCommercial ? '/contact' : '/book-pickup'} class="btn btn-primary">{page.cta}</a>
				<a href={isCommercial ? '/commercial-laundry' : '/pricing'} class="btn btn-secondary">{isCommercial ? 'Commercial Laundry' : 'View Pricing'}</a>
			</div>
		</div>
	</section>

	<section>
		<div class="container content">
			{isPolicy ? (
				<>
					<h2>Policy Summary</h2>
					{isCookiePolicy ? (
						<>
							<p>Fresh Fold Delivery currently uses local storage only to remember your cookie-consent choice. No analytics or advertising scripts are enabled on this site.</p>
							<h2>Third-Party Content</h2>
							<p>Some pages include an OpenStreetMap map embed. The map provider may process connection data when the map loads. You can avoid the embed by not loading the service-area map.</p>
							<h2>Your Choice</h2>
							<p>You can reject optional cookies in the consent banner. Necessary site functionality may still operate. This draft should be reviewed with the business's legal adviser before publication.</p>
						</>
					) : (
						<>
							<p>This page is the public policy location for {page.h1.toLowerCase()}. It should be reviewed before checkout and linked from the footer, booking flow, and any related customer support messages.</p>
							<p>Fresh Fold Delivery separates laundry processing, delivery, mileage, tips, add-ons, specialty items, bag deposits, missed pickup fees, redelivery fees, and commercial custom quotes unless a specific written offer says otherwise.</p>
							<p>Customers should remove pocket items, identify special-care laundry, disclose heavy soil or pet hair, and contact support quickly if an order needs review.</p>
						</>
					)}
				</>
			) : isCommercial ? (
				<>
					<h2>Commercial Laundry Built Around Your Route</h2>
					<p>Fresh Fold Delivery handles commercial laundry requests by quote so the schedule, route distance, volume, item type, and care requirements are clear before service begins.</p>
					<h2>Common Laundry Needs</h2>
					<p>Businesses can request towels, linens, sheets, robes, capes, bedding, rental turnover laundry, gym towels, and other recurring wash dry fold needs.</p>
					<h2>Get a Quote</h2>
					<p>Send your ZIP code, estimated weekly volume, pickup frequency, and item mix. A Fresh Fold Delivery team member can confirm service availability and next steps.</p>
				</>
			) : (
				<>
					<h2>Fresh Fold Pickup & Delivery</h2>
					<p>Fresh Fold Delivery offers local laundry pickup, wash, dry, fold, and delivery for eligible Central PA customers. Service availability depends on ZIP code, route status, and schedule capacity.</p>
					<h2>Pricing and Delivery</h2>
					<p>Final laundry pricing is based on actual weight. Delivery is separate unless a coupon, promotion, written agreement, Delivery Pass benefit, or admin override applies.</p>
					<h2>Helpful Next Steps</h2>
					<p>Check your service area, review the pricing page, or book a pickup to start. Commercial customers should request a custom quote.</p>
				</>
			)}
			<div class="links">
				<a href="/pricing">Pricing</a>
				<a href="/book-pickup">Book Pickup</a>
				<a href="/service-areas">Service Areas</a>
				<a href="/contact">Contact</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.hero {
		background: #f0f4f8;
		padding: 64px 0;
		text-align: center;
	}

	.eyebrow {
		color: var(--primary);
		font-weight: 700;
		text-transform: uppercase;
	}

	.hero p,
	.content {
		max-width: 820px;
	}

	.hero p {
		margin: 16px auto 0;
	}

	.actions,
	.links {
		display: flex;
		justify-content: center;
		gap: 14px;
		flex-wrap: wrap;
		margin-top: 28px;
	}

	.content h2 {
		margin: 28px 0 12px;
		color: var(--dark);
	}

	.links {
		justify-content: flex-start;
	}

	.links a {
		color: var(--primary);
		font-weight: 700;
	}
</style>
